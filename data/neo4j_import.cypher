MERGE (n:Recipe {nodeId: "e117c8f8515e3d7f"}) SET n += {name: "可乐鸡翅", category: "荤菜", difficulty: "中等", cuisineType: "家常菜", servings: "1盘", tips: "加入生姜爆香的同时能防止鸡翅粘锅。 | 最后收汁时勿开过大火，防止味道偏苦。 | 本菜品偏甜。", filePath: "Dish/dinner and lunch/meat/可乐鸡翅.md"};
MERGE (n:Recipe {nodeId: "752118f8c9c8d947"}) SET n += {name: "咕噜肉", category: "荤菜", difficulty: "困难", cuisineType: "粤菜", tips: "想让肉更有层次可以在生粉中加鸡蛋，炸出来会更香脆", filePath: "Dish/dinner and lunch/meat/咕噜肉.md"};
MERGE (n:Recipe {nodeId: "1a45cafc6e7d6e8c"}) SET n += {name: "咖喱炒蟹", category: "荤菜", difficulty: "困难", cuisineType: "家常菜", servings: "1人份", tips: "螃蟹切口和蟹钳蘸生粉，蟹盖撒生粉盖住蟹黄，有助于锁住鲜味和蟹黄。 | 煎螃蟹时先切口朝下，可以封住蟹肉和蟹黄。 | 关火后倒入椰浆和蛋清并不断翻炒，可以使酱汁更浓稠。", filePath: "Dish/dinner and lunch/meat/咖喱炒蟹.md"};
MERGE (n:Recipe {nodeId: "9cfd60e27d37b519"}) SET n += {name: "响油鳝丝", category: "荤菜", difficulty: "中等", cuisineType: "江浙菜", servings: "2人份", tips: "不能将鳝鱼的血洗得太干净，否则鳝鱼很容易发黑发臭。 | 可以多加一些胡椒粉和白糖，有利于去腥增香。", filePath: "Dish/dinner and lunch/meat/响油鳝丝.md"};
MERGE (n:Recipe {nodeId: "4ad03a810d7ef263"}) SET n += {name: "小龙虾", category: "荤菜", difficulty: "困难", cuisineType: "家常菜", tips: "家庭制作可用比炒菜多些的油煎代替油炸，同样好吃。 | 去虾线会影响虾肉口感且对新手有难度，能接受虾线可不去。", filePath: "Dish/dinner and lunch/meat/小龙虾.md"};
MERGE (n:Recipe {nodeId: "10fc84e21e0a20e9"}) SET n += {name: "微波葱姜黑鳕鱼", category: "荤菜", difficulty: "中等", cuisineType: "家常菜", servings: "2份", tips: "本菜谱主角是黑鳕鱼，所有调料可根据鳕鱼的实际重量进行比例调整。 | 如果想让香气更为浓郁，在微波前可将葱姜与料酒均匀涂抹在鱼片的两侧，再进行微波加热。 | 可使用海鲈鱼、罗非鱼、大比目鱼或龙脷鱼替代，具体重量和微波时间请参考菜谱中的附加表格。", filePath: "Dish/dinner and lunch/meat/微波葱姜黑鳕鱼.md"};
MERGE (n:Recipe {nodeId: "c9bfcbfa7fe2af5a"}) SET n += {name: "油焖大虾", category: "荤菜", difficulty: "困难", cuisineType: "家常菜", servings: "1人份", tips: "炸好的葱油可以留着作为拌面使用。 | 焖煮中途不能再加汤水，不要开盖。", filePath: "Dish/dinner and lunch/meat/油焖大虾.md"};
MERGE (n:Recipe {nodeId: "e8198a4a3b8d77b3"}) SET n += {name: "清蒸生蚝", category: "荤菜", difficulty: "中等", cuisineType: "家常菜", filePath: "Dish/dinner and lunch/meat/清蒸生蚝.md"};
MERGE (n:Recipe {nodeId: "d23044499d5e537f"}) SET n += {name: "清蒸鲈鱼", category: "荤菜", difficulty: "中等", cuisineType: "家常菜", tips: "关键点在于火候，鱼的大小跟火候都会相关，大火蒸鱼一般是10分钟内较佳。 | 切记蒸鱼需要用筷子隔开装鱼的盘子，这样做的好处有两点：1、鱼在蒸的过程中会将水滴到盘子，如果鱼直接接触会导致鱼食用时会腥。2、能够将鱼均匀受热。", filePath: "Dish/dinner and lunch/meat/清蒸鲈鱼.md"};
MERGE (n:Recipe {nodeId: "1cdfa62341896e19"}) SET n += {name: "糖醋里脊", category: "荤菜", difficulty: "困难", cuisineType: "家常菜", tips: "里脊要多炸几遍，注意火候，否则达不到外焦里嫩的效果！", filePath: "Dish/dinner and lunch/meat/糖醋里脊.md"};
MERGE (n:Recipe {nodeId: "6516452c79f80d4b"}) SET n += {name: "红烧鸡翅", category: "荤菜", difficulty: "中等", cuisineType: "家常菜", cookTime: "40分钟", servings: "3-4人份", tips: "如果闻着有腥味，可以增加一倍香料用量。 | 鸡翅打花刀便于入味。 | 炒糖色时需注意火候，避免炒焦。", filePath: "Dish/dinner and lunch/meat/红烧鸡翅.md"};
MERGE (n:Recipe {nodeId: "9f7d4afe5eccd67a"}) SET n += {name: "芥末黄油罗氏虾", category: "荤菜", difficulty: "中等", cuisineType: "家常菜", servings: "1盘", tips: "酱汁提前调配好，黄油提前备好，防止中间备料耗时。 | 蒜蓉切记要等虾煎好后捞出再下，防止煎炒过久变黑，发苦。 | 如果不太能接受芥末就放少点，能接受就放多点，如果放多了，煮久一会儿，芥末味也会散去。", filePath: "Dish/dinner and lunch/meat/芥末黄油罗氏虾.md"};
MERGE (n:Recipe {nodeId: "8e46bd7b2500c596"}) SET n += {name: "葱烧海参", category: "荤菜", difficulty: "中等", cuisineType: "家常菜", servings: "每份", tips: "操作时，需要注意观察锅中的水量，如快见底的时候就直接接入水淀粉即可。", filePath: "Dish/dinner and lunch/meat/葱烧海参.md"};
MERGE (n:Recipe {nodeId: "3c3d21fead9586f0"}) SET n += {name: "西红柿炒鸡蛋", category: "荤菜", difficulty: "简单", cuisineType: "家常菜", servings: "1人份", tips: "向鸡蛋液中加入少量醋可以去除腥味，令鸡蛋更蓬松。 | 快速做法：直接在炒好半熟鸡蛋的锅中加入西红柿块，一起翻炒至软烂，再继续调味。 | 可根据口味偏好，将加盐改为加入两滴生抽。", filePath: "Dish/dinner and lunch/meat/西红柿炒鸡蛋.md"};
MERGE (n:Recipe {nodeId: "341c1e25d75a4199"}) SET n += {name: "辣椒炒肉", category: "荤菜", difficulty: "中等", cuisineType: "家常菜", servings: "1人份", tips: "辣椒只能选择青椒，螺丝椒为最优解，切勿选择其他品种辣椒！ | 本道菜需要一定料理基础，不推荐新手尝试。", filePath: "Dish/dinner and lunch/meat/辣椒炒肉.md"};
MERGE (n:Recipe {nodeId: "67707d0a25be00b7"}) SET n += {name: "鸡蛋火腿炒黄瓜", category: "荤菜", difficulty: "简单", cuisineType: "家常菜", servings: "1人份", tips: "火腿是咸的，要在调味后才加入，这样不会让火腿也沾上盐。", filePath: "Dish/dinner and lunch/meat/鸡蛋火腿炒黄瓜.md"};
MERGE (n:Recipe {nodeId: "ac1a17871b1eae0f"}) SET n += {name: "黄焖鸡", category: "荤菜", difficulty: "中等", cuisineType: "家常菜", tips: "干香菇最佳，泡发后留香菇水备用，可使风味更佳。 | 炒糖色有一定难度，新手可跳过此步，在炒鸡肉时直接使用老抽替代上色。 | 汤汁不要收得太干。", filePath: "Dish/dinner and lunch/meat/黄焖鸡.md"};
MERGE (n:Recipe {nodeId: "c5bb059702549bf3"}) SET n += {name: "排骨苦瓜汤", category: "汤品", difficulty: "困难", cuisineType: "家常菜", servings: "4人份", tips: "可以使用其他带有鲜味的食材代替虾皮，如瑶柱。 | 在120分钟之后可以捞出一块肉进行品尝，若肉可以较为轻松的从骨头上分离即可关火。", filePath: "Dish/dinner and lunch/soup/排骨苦瓜汤.md"};
MERGE (n:Recipe {nodeId: "10cf45e70b7fe3eb"}) SET n += {name: "玉米排骨汤", category: "汤品", difficulty: "中等", cuisineType: "家常菜", tips: "排骨焯水时凉水下锅，能更好地去除血沫和腥味。 | 煸炒排骨时放入醋，可以加速肉质软烂。 | 炖汤时开水要一次加足，中途不要加水。", filePath: "Dish/dinner and lunch/soup/玉米排骨汤.md"};
MERGE (n:Recipe {nodeId: "8e0c85939ec53b4c"}) SET n += {name: "紫菜蛋花汤", category: "汤品", difficulty: "简单", cuisineType: "家常菜", servings: "1人份", tips: "水开后，将火关小，将打好的蛋液围绕中间沸腾的水倒入。为了使蛋花比较嫩，锅盖盖上熄灭火等半分钟后再打开。 | 如果喜欢浓稠口感，可加入2g淀粉。", filePath: "Dish/dinner and lunch/soup/紫菜蛋花汤.md"};
MERGE (n:Recipe {nodeId: "231d29d4ab20abb3"}) SET n += {name: "羊肉汤", category: "汤品", difficulty: "中等", cuisineType: "家常菜", tips: "加入开水时，注意要开大火，使油脂与汤汁更好的融合。", filePath: "Dish/dinner and lunch/soup/羊肉汤.md"};
MERGE (n:Recipe {nodeId: "66a094b270e52b80"}) SET n += {name: "菌菇炖乳鸽", category: "汤品", difficulty: "困难", cuisineType: "家常菜", servings: "2人份", tips: "焯水时间不宜过长，水开即可捞出，以免营养流失。 | 根据使用的工具（高压锅或瓦罐）调整炖煮时间。", filePath: "Dish/dinner and lunch/soup/菌菇炖乳鸽.md"};
MERGE (n:Recipe {nodeId: "edea0ef34af44d12"}) SET n += {name: "凉拌金针菇", category: "素菜", difficulty: "简单", cuisineType: "家常菜", servings: "1人份", tips: "金针菇焯水时间不宜过长，以免影响口感。 | 酱汁的比例可以根据个人口味喜好进行调整。 | 如果不喜欢吃辣，可以省略辣椒油。", filePath: "Dish/dinner and lunch/vegetable/凉拌金针菇.md"};
MERGE (n:Recipe {nodeId: "70c402155afe1003"}) SET n += {name: "地三鲜", category: "素菜", difficulty: "中等", cuisineType: "家常菜", servings: "2-4人份", tips: "糖比淀粉多是非常合理的。淀粉在这里不负责提供味道，它只是一种物理增稠剂。 | 茄子在煎炸以后，体积会缩小4倍。这是正常的。 | 青椒下锅的瞬间可能会爆发很多水分，导致油飞溅。务必下锅时用锅盖当盾牌挡在身前，小心下锅。", filePath: "Dish/dinner and lunch/vegetable/地三鲜.md"};
MERGE (n:Recipe {nodeId: "9bf4de02fa6481be"}) SET n += {name: "手撕包菜", category: "素菜", difficulty: "中等", cuisineType: "湘菜", tips: "步骤五中，翻炒时间需要实际情况做调整，一般是炒到包菜七分熟后即可。七分熟是指包菜已经出水质感变软。 | 步骤五中，加盐的作用是锁住包菜水分的同时，给包菜上一点味道。 | 最后一个步骤中，翻炒时间根据实际情况和个人口感做灵活调整。", filePath: "Dish/dinner and lunch/vegetable/手撕包菜.md"};
MERGE (n:Recipe {nodeId: "f4415ea6d38cbb10"}) SET n += {name: "炒青菜", category: "素菜", difficulty: "简单", cuisineType: "家常菜", cookTime: "10分钟", servings: "1人份", tips: "加入白糖，会让青菜颜色更绿。", filePath: "Dish/dinner and lunch/vegetable/炒青菜.md"};
MERGE (n:Recipe {nodeId: "27adf0170b6bf40b"}) SET n += {name: "白灼菜心", category: "素菜", difficulty: "简单", cuisineType: "粤菜", servings: "2人份", tips: "选择菜心一定要比较新鲜。 | 锅内烧清水要加油和盐。 | 料汁中可加淀粉使汤汁更容易挂在菜心上。", filePath: "Dish/dinner and lunch/vegetable/白灼菜心.md"};
MERGE (n:Recipe {nodeId: "e118194e75dd4f14"}) SET n += {name: "蒲烧茄子", category: "素菜", difficulty: "中等", cuisineType: "家常菜", tips: "如果觉得腻可以在装盘后撒点切成2~5 mm的小葱，颜色搭配上也能不那么单调。 | 灵魂其实在于蒲烧汁？也可以买现成的蒲烧汁。", filePath: "Dish/dinner and lunch/vegetable/蒲烧茄子.md"};
MERGE (n:Recipe {nodeId: "5ce30efa50cfddd6"}) SET n += {name: "冬瓜茶", category: "饮品", difficulty: "简单", cuisineType: "家常菜", servings: "4-5人份", tips: "冰糖的用量可以调整，以达到个人喜好的甜度。 | 冷藏保存，建议 1 周内喝完。", filePath: "Dish/drink/冬瓜茶.md"};
MERGE (n:Recipe {nodeId: "baee12f238d2a420"}) SET n += {name: "冰粉", category: "饮品", difficulty: "简单", cuisineType: "豫菜", cookTime: "3小时", servings: "5人份", tips: "操作时，需要注意观察凉白开的颜色和粘度变化，如颜色过浅或者水不黏，则说明冰粉籽量不足，或者是揉搓力度和时间没有到位。", filePath: "Dish/drink/冰粉.md"};
MERGE (n:Recipe {nodeId: "ad4d67d72d012e77"}) SET n += {name: "杨枝甘露", category: "饮品", difficulty: "简单", cuisineType: "家常菜", tips: "奇亚籽可以代替西谷米，用泡不用煮，省时。 | 点缀用的芒果干和柳橙干是可选材料。", filePath: "Dish/drink/杨枝甘露.md"};
MERGE (n:Recipe {nodeId: "df61c64ff1221e05"}) SET n += {name: "柠檬水", category: "饮品", difficulty: "非常简单", cuisineType: "家常菜", servings: "一杯分量，约500毫升", filePath: "Dish/drink/柠檬水.md"};
MERGE (n:Recipe {nodeId: "79af32784f41f8d7"}) SET n += {name: "酸梅汤", category: "饮品", difficulty: "困难", cuisineType: "家常菜", prepTime: "2小时以上", cookTime: "60分钟", tips: "放入冰箱冷藏后再饮用效果更佳。 | 所有用量可以等比例增加或减小。", filePath: "Dish/drink/酸梅汤.md"};
MERGE (n:Recipe {nodeId: "3d2c24a9e6128d1b"}) SET n += {name: "长岛冰茶", category: "饮品", difficulty: "简单", cuisineType: "西式", servings: "一杯分量", tips: "长岛冰茶不含茶却有着冰茶的口感，是一种有着较高酒精度（约15%），但口感柔和易于接受的鸡尾酒。", filePath: "Dish/drink/长岛冰茶.md"};
MERGE (n:Recipe {nodeId: "cab2fc63a5052cdf"}) SET n += {name: "意式肉酱面", category: "主食", difficulty: "非常简单", cuisineType: "西式", cookTime: "15分钟", servings: "2人份", tips: "意大利面分为很多不同的粗细，煮面条之前请注意意面盒子上标注的时间。 | 意大利面酱并不是番茄酱，平常用的番茄酱准确是叫番茄沙司，而意大利面酱虽然和番茄沙司都是调味过的番茄酱，但加的调味料不同。", filePath: "Dish/staple/意式肉酱面.md"};
MERGE (n:Recipe {nodeId: "08b06913ca4bcbf9"}) SET n += {name: "手工水饺", category: "主食", difficulty: "非常困难", cuisineType: "家常菜", servings: "单人份", tips: "煮水饺不需要盖锅盖，加三次水就是为了不让饺子一直处于沸腾状态导致表皮破损变成面片。 | 考虑搭配黑醋、姜丝、香油或蒜泥制作蘸料。", filePath: "Dish/staple/手工水饺.md"};
MERGE (n:Recipe {nodeId: "df3193c840da51b3"}) SET n += {name: "日式咖喱饭", category: "主食", difficulty: "困难", cuisineType: "日式", servings: "6碗份", tips: "做好的咖喱在冰箱冷藏后风味更佳。 | 步骤1-6可以在2-5的等待过程进行。 | 2-5到2-6之间，如发现沸腾的水位线低于2/3的食材应加热水至没过食材。", filePath: "Dish/staple/日式咖喱饭.md"};
MERGE (n:Recipe {nodeId: "d01fb58c10c074ab"}) SET n += {name: "汤面", category: "主食", difficulty: "简单", cuisineType: "家常菜", servings: "单人份", tips: "操作流程可根据自己喜好更改，多多尝试会有惊喜。 | 如掌握不好加盐量，可采用少量多次添加的方法，以免过量。", filePath: "Dish/staple/汤面.md"};
MERGE (n:Recipe {nodeId: "c04c1e48cdee7433"}) SET n += {name: "炒河粉", category: "主食", difficulty: "困难", cuisineType: "家常菜", tips: "建议购买袋装鲜河粉，冷藏保质期可达两周，且送河粉炒料。 | 清洗面筋后，请用手将面筋中的大量水分挤出（不需过于用力）。 | 个人口味根据地区、天气、时间均有不同，调料的具体使用量请据个人情况而定。", filePath: "Dish/staple/炒河粉.md"};
MERGE (n:Recipe {nodeId: "7b95331831a1ca04"}) SET n += {name: "老友猪肉粉", category: "主食", difficulty: "中等", cuisineType: "家常菜", tips: "米粉必须用50度的温水泡半小时后再使用，否则很难吃。", filePath: "Dish/staple/老友猪肉粉.md"};
MERGE (n:Recipe {nodeId: "9b74b814b01bfbf2"}) SET n += {name: "葱油拌面", category: "主食", difficulty: "简单", cuisineType: "家常菜", cookTime: "20分钟", servings: "1人份", tips: "炸葱油时，火一定要小，要有耐心，才能将葱的香味充分炸出。 | 制作好的葱油酱汁可以冷藏保存一段时间，下次吃面时直接取用。", filePath: "Dish/staple/葱油拌面.md"};
MERGE (n:Recipe {nodeId: "40550630c0042c0c"}) SET n += {name: "蛋炒饭", category: "主食", difficulty: "中等", cuisineType: "家常菜", servings: "1-2人份", tips: "使用隔夜的冷饭炒饭最佳，没有冷饭的同学也可以现煮（可以使用冰箱立马给米饭降温），不过要做到“粒粒分明”的口感就需要炒更久。 | 炒饭要做到“粒粒分明”其实就是要将饭炒干。为什么要用隔夜的冷饭是因为隔夜已经流失了一定的水分。", filePath: "Dish/staple/蛋炒饭.md"};

