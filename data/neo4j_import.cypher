MERGE (n:CookingStep {nodeId: "0813aecd92148f1d"}) SET n += {name: "油焖大虾-步骤8", description: "浇汁，完成。", stepNumber: "8"};
MERGE (n:CookingStep {nodeId: "e664650c297ff743"}) SET n += {name: "清蒸生蚝-步骤1", description: "将生蚝用刷子刷干净（没有刷子用牙刷）。", stepNumber: "1", tools: "刷子"};
MERGE (n:CookingStep {nodeId: "7b8b5dba70d9046b"}) SET n += {name: "清蒸生蚝-步骤2", description: "蒸锅中放水，将蒸屉放上之后，将6个生蚝平铺在蒸屉，使用50%功率，蒸3分钟。", stepNumber: "2", methods: "蒸", tools: "蒸锅，蒸屉", timeEstimate: "3分钟"};
