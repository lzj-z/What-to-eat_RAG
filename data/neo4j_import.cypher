MERGE (n:CookingStep {nodeId: "2f318307e2114361"}) SET n += {name: "小龙虾-步骤1", description: "小龙虾刷干净去虾线，葱切2cm葱段，姜蒜切末。", stepNumber: "1"};
MERGE (n:CookingStep {nodeId: "01873a4542602205"}) SET n += {name: "小龙虾-步骤2", description: "烧油，油微热，下香叶、八角、桂皮、青花椒、花椒、子弹头辣椒。", stepNumber: "2", methods: "炒", tools: "锅"};
