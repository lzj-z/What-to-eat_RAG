MERGE (n:CookingStep {nodeId: "e16e55c6943fe653"}) SET n += {name: "手抓饼-步骤1", description: "面粉放入碗中，加入开水搅拌成絮状，再加入冷水揉成光滑面团，覆盖湿布静置20分钟。", stepNumber: "1", tools: "碗", timeEstimate: "20分钟"};
MERGE (n:CookingStep {nodeId: "288fd8a9e3fb34e8"}) SET n += {name: "手抓饼-步骤2", description: "面团分成每份约100克，搓圆，擀成薄片。", stepNumber: "2"};
MERGE (n:CookingStep {nodeId: "b55bfc8c29003072"}) SET n += {name: "手抓饼-步骤3", description: "表面均匀涂抹食用油，撒上盐，卷成蜗牛状，松弛10分钟。", stepNumber: "3", timeEstimate: "10分钟"};
MERGE (n:CookingStep {nodeId: "176958aafd7c0276"}) SET n += {name: "手抓饼-步骤4", description: "面团再次擀成薄饼，厚度均匀。", stepNumber: "4"};
MERGE (n:CookingStep {nodeId: "fcc65fcb01fdfa4b"}) SET n += {name: "手抓饼-步骤5", description: "热锅中倒入油，小火煎至两面金黄起泡。", stepNumber: "5", methods: "煎", tools: "锅"};
MERGE (n:CookingStep {nodeId: "8ac6cf1088871015"}) SET n += {name: "手抓饼-步骤6", description: "煎好的饼依次铺入煎蛋、生菜、火腿、芝士片等配料，卷起即可。", stepNumber: "6", methods: "煎"};
MERGE (n:CookingStep {nodeId: "c0dfd5b6c37ab3a1"}) SET n += {name: "桂圆红枣粥-步骤1", description: "将桂圆肉扒出，用清水洗两次，放入碗中浸泡10分钟", stepNumber: "1", methods: "清洗，浸泡", tools: "碗", timeEstimate: "10分钟"};
MERGE (n:CookingStep {nodeId: "d3918f0ed2c70b81"}) SET n += {name: "桂圆红枣粥-步骤2", description: "红枣用清水洗两次，放入碗中浸泡10分钟", stepNumber: "2", methods: "清洗，浸泡", tools: "碗", timeEstimate: "10分钟"};
MERGE (n:CookingStep {nodeId: "25a712510825033a"}) SET n += {name: "桂圆红枣粥-步骤3", description: "糯米放入电饭锅中，清水淘米两次后，加入2000ml水", stepNumber: "3", methods: "淘洗", tools: "电饭锅"};
MERGE (n:CookingStep {nodeId: "15ef3cb76b796d74"}) SET n += {name: "桂圆红枣粥-步骤4", description: "将桂圆和红枣加入电饭锅", stepNumber: "4", tools: "电饭锅"};
MERGE (n:CookingStep {nodeId: "c8b58157551fcfaf"}) SET n += {name: "桂圆红枣粥-步骤5", description: "打开电饭锅煮饭模式，1小时后粥成", stepNumber: "5", methods: "煮", tools: "电饭锅", timeEstimate: "1小时"};
MERGE (n:CookingStep {nodeId: "bc91682a9d51ea19"}) SET n += {name: "水煮玉米-步骤1", description: "将新鲜玉米剥去外皮，剩部分玉米皮入锅。", stepNumber: "1", tools: "锅"};
MERGE (n:CookingStep {nodeId: "5e77d365676eee5a"}) SET n += {name: "水煮玉米-步骤2", description: "加入淹过玉米约半节指头的水，加盐和糖。", stepNumber: "2"};
MERGE (n:CookingStep {nodeId: "2e85a4e16b12d76f"}) SET n += {name: "水煮玉米-步骤3", description: "水煮开之后转至小火，加盖继续煮15-20分钟，玉米煮久点没事。", stepNumber: "3", methods: "煮", tools: "锅", timeEstimate: "15-20分钟"};
MERGE (n:CookingStep {nodeId: "13a2eaf822c9014c"}) SET n += {name: "水煮玉米-步骤4", description: "煮熟后沥干水分，冷却后食用。", stepNumber: "4", methods: "沥干"};
MERGE (n:CookingStep {nodeId: "bcc99d7866dd03a8"}) SET n += {name: "煎饺-步骤1", description: "取出平底锅（不沾平底锅最佳）。", stepNumber: "1", tools: "平底锅"};
MERGE (n:CookingStep {nodeId: "e783f02563c66dd1"}) SET n += {name: "煎饺-步骤2", description: "加入 10ml - 15 ml 食用油。", stepNumber: "2"};
MERGE (n:CookingStep {nodeId: "0043a319327e7a5a"}) SET n += {name: "煎饺-步骤3", description: "开火，放入饺子（尽量平均铺开，不宜堆叠）。", stepNumber: "3"};
MERGE (n:CookingStep {nodeId: "b486db460d802510"}) SET n += {name: "煎饺-步骤4", description: "立刻加入清水，水线没过饺子平均高度的 1/2。", stepNumber: "4"};
MERGE (n:CookingStep {nodeId: "f35947323303ec4a"}) SET n += {name: "煎饺-步骤5", description: "盖上锅盖（此时炉灶应该处于大火）。", stepNumber: "5", methods: "煮", tools: "锅盖"};
MERGE (n:CookingStep {nodeId: "0bfdd6307b40b1aa"}) SET n += {name: "煎饺-步骤6", description: "等待 8 - 10 分钟。", stepNumber: "6", methods: "煮", timeEstimate: "8-10分钟"};
MERGE (n:CookingStep {nodeId: "d9fded28ff80a551"}) SET n += {name: "煎饺-步骤7", description: "当锅中水分仅剩 2mm 时， 转中火开始煎制。", stepNumber: "7", methods: "煎"};
MERGE (n:CookingStep {nodeId: "33ea27e844dbd906"}) SET n += {name: "煎饺-步骤8", description: "当水分全部蒸发后，摇晃平底锅使饺子受热均匀。", stepNumber: "8", methods: "煎", tools: "平底锅"};
MERGE (n:CookingStep {nodeId: "8ca84cc99f190e02"}) SET n += {name: "煎饺-步骤9", description: "放入黑芝麻和葱花再焖 10s。", stepNumber: "9", methods: "焖", timeEstimate: "10秒"};
MERGE (n:CookingStep {nodeId: "4ad8dfc15b0ebcbd"}) SET n += {name: "煎饺-步骤10", description: "1 - 2 分钟夹出一个饺子观察底部，若出现金黄色脆皮立即取出。", stepNumber: "10", methods: "煎", timeEstimate: "1-2分钟"};
MERGE (n:CookingStep {nodeId: "71cf367251833542"}) SET n += {name: "茶叶蛋-步骤1", description: "用冷水将鸡蛋煮熟，大火大约8分钟（根据自家厨具决定）。", stepNumber: "1", methods: "煮", tools: "锅", timeEstimate: "8分钟"};
MERGE (n:CookingStep {nodeId: "6365c10770d4d65f"}) SET n += {name: "茶叶蛋-步骤2", description: "鸡蛋捞出，过冷水。", stepNumber: "2", methods: "过冷水"};
MERGE (n:CookingStep {nodeId: "940981003c397680"}) SET n += {name: "茶叶蛋-步骤3", description: "将鸡蛋互相碰撞，使每个鸡蛋产生裂缝。", stepNumber: "3"};
MERGE (n:CookingStep {nodeId: "cf5695a9e3163000"}) SET n += {name: "茶叶蛋-步骤4", description: "将鸡蛋下锅，放入八角，香叶，桂皮，茴香，冰糖，红茶，生抽，老抽，食盐。", stepNumber: "4", tools: "锅"};
MERGE (n:CookingStep {nodeId: "7a175b2154d85d6e"}) SET n += {name: "茶叶蛋-步骤5", description: "加水直至没过鸡蛋。", stepNumber: "5"};
MERGE (n:CookingStep {nodeId: "ca8d5f3a27f78d77"}) SET n += {name: "茶叶蛋-步骤6", description: "大火煮开之后，转中小火煮15分钟。", stepNumber: "6", methods: "煮", tools: "锅", timeEstimate: "15分钟"};
MERGE (n:CookingStep {nodeId: "679c6e7f2b27db3b"}) SET n += {name: "蛋煎糍粑-步骤1", description: "把糍粑切成长方形小块，便于后面煎。", stepNumber: "1", tools: "刀"};
MERGE (n:CookingStep {nodeId: "1d6391098f058ee8"}) SET n += {name: "蛋煎糍粑-步骤2", description: "碗里打入一个鸡蛋并把鸡蛋搅碎，加入 2g 食用盐。", stepNumber: "2", tools: "碗"};
MERGE (n:CookingStep {nodeId: "a20cf7a1211663a7"}) SET n += {name: "蛋煎糍粑-步骤3", description: "将切好的小糍粑依此放入搅碎的鸡蛋里面，涂抹完糍粑双面为止。", stepNumber: "3"};
MERGE (n:CookingStep {nodeId: "5239925175359b12"}) SET n += {name: "蛋煎糍粑-步骤4", description: "锅里倒入植物油 10ml ，把涂抹好的糍粑小块放进去小火慢慢煎软。", stepNumber: "4", methods: "煎", tools: "锅"};
MERGE (n:CookingStep {nodeId: "487d84ee0d1005ca"}) SET n += {name: "蛋煎糍粑-步骤5", description: "将剩下的鸡蛋液慢慢倒在糍粑表面。", stepNumber: "5"};
MERGE (n:CookingStep {nodeId: "f4cebd139bbf714d"}) SET n += {name: "蛋煎糍粑-步骤6", description: "用筷子或者勺子为糍粑翻面，来回煎至金黄色后开吃。", stepNumber: "6", methods: "煎", tools: "筷子,勺子"};
MERGE (n:CookingStep {nodeId: "0c3a2907a94934e0"}) SET n += {name: "鸡蛋三明治-步骤1", description: "吐司切去四边，备用", stepNumber: "1"};
MERGE (n:CookingStep {nodeId: "db190c0ce1f96ee4"}) SET n += {name: "鸡蛋三明治-步骤2", description: "鸡蛋煮熟，捣碎", stepNumber: "2", methods: "煮"};
MERGE (n:CookingStep {nodeId: "b88048af8cb082df"}) SET n += {name: "鸡蛋三明治-步骤3", description: "混合鸡蛋、蛋黄酱、盐、黑胡椒", stepNumber: "3"};
MERGE (n:CookingStep {nodeId: "d5d51a040c9b3079"}) SET n += {name: "鸡蛋三明治-步骤4", description: "锅中加入黄油，煎熟培根", stepNumber: "4", methods: "煎", tools: "锅"};
MERGE (n:CookingStep {nodeId: "653c54f5382c2db6"}) SET n += {name: "鸡蛋三明治-步骤5", description: "组装吐司，在两片吐司间加入制作好的鸡蛋酱及培根", stepNumber: "5"};
MERGE (n:CookingStep {nodeId: "042038579f180e23"}) SET n += {name: "鸡蛋三明治-步骤6", description: "四边形吐司切成三角形装盘", stepNumber: "6"};
MERGE (n:CookingStep {nodeId: "0b83459963f98b6b"}) SET n += {name: "可乐鸡翅-步骤1", description: "鸡翅入锅，倒入冷水淹没。放生姜1片和料酒10～20毫升。大火煮开（大约2分钟）后，撇去浮沫，沥出水分。这一步针对冰鲜鸡翅，刚买来的鸡翅直接改刀用生抽进行腌制即可。", stepNumber: "1", methods: "焯水", tools: "锅", timeEstimate: "约2分钟"};
MERGE (n:CookingStep {nodeId: "bbf29dd27666fcd1"}) SET n += {name: "可乐鸡翅-步骤2", description: "捞出鸡翅，可用刀将两边各划上两口改刀。生抽约10克腌制鸡翅10分钟（生抽能完全包裹鸡翅表面入味就行）。", stepNumber: "2", methods: "腌制", tools: "刀", timeEstimate: "10分钟"};
MERGE (n:CookingStep {nodeId: "60d6e7c4e2fa2151"}) SET n += {name: "可乐鸡翅-步骤3", description: "锅重新小火起油，先将剩余姜片爆香，然后下入腌好的鸡翅。将鸡翅煎至金黄翻面（直到两面金黄），用炒菜勺子翻动一下鸡翅，与姜片一起翻炒4～5下（目的是防止鸡翅和姜片粘黏）。", stepNumber: "3", methods: "爆香,煎,炒", tools: "锅,炒菜勺"};
MERGE (n:CookingStep {nodeId: "012011c104117849"}) SET n += {name: "可乐鸡翅-步骤4", description: "鸡翅金黄，倒入可乐没过鸡翅，开大火将锅中可乐煮沸，然后撇去漂浮的黑色浮沫（包含血水）。此时加入葱结。", stepNumber: "4", methods: "煮", tools: "锅"};
MERGE (n:CookingStep {nodeId: "760b3df138fc2392"}) SET n += {name: "可乐鸡翅-步骤5", description: "调味：加入食用盐2克，白糖10克，生抽3克调味（可以适当用老抽调底色，3克）。", stepNumber: "5"};
MERGE (n:CookingStep {nodeId: "72bc9f0d6cf8a2b6"}) SET n += {name: "可乐鸡翅-步骤6", description: "等到葱结变黄，和姜片一起捞出，转中火继续慢煮可乐鸡翅。", stepNumber: "6", methods: "煮", tools: "锅"};
MERGE (n:CookingStep {nodeId: "e68c707064a1013f"}) SET n += {name: "可乐鸡翅-步骤7", description: "等到可乐呈现挂丝状态，关小火让汁牢牢挂在鸡翅上。出锅，装盘。", stepNumber: "7", methods: "收汁", tools: "锅"};
MERGE (n:CookingStep {nodeId: "e82e6073646e1dc3"}) SET n += {name: "咕噜肉-步骤1", description: "将梅头猪肉（100克）洗净，然后用厨房纸抹干水份，将猪肉切成比想要的成品小一圈的大小。", stepNumber: "1", tools: "厨房纸"};
MERGE (n:CookingStep {nodeId: "2f0845532e0b0777"}) SET n += {name: "咕噜肉-步骤2", description: "用盐（1/2茶匙）腌制梅头猪肉20分钟。", stepNumber: "2", methods: "腌制", timeEstimate: "20分钟"};
MERGE (n:CookingStep {nodeId: "a46e60dd16ccfc1c"}) SET n += {name: "咕噜肉-步骤3", description: "将青椒（25克）切碎。", stepNumber: "3"};
MERGE (n:CookingStep {nodeId: "dac81e3179304769"}) SET n += {name: "咕噜肉-步骤4", description: "将菠萝片（75克）切件。", stepNumber: "4"};
MERGE (n:CookingStep {nodeId: "883392ec7a4ef941"}) SET n += {name: "咕噜肉-步骤5", description: "在碗中加入茄汁（4汤匙）、白醋（2茶匙）、蒜蓉（1汤匙）、生抽（½茶匙）、生粉（2½茶匙）、白砂糖（2汤匙）、盐（¼茶匙）和水（200毫升），拌匀成酱汁。", stepNumber: "5", tools: "碗"};
MERGE (n:CookingStep {nodeId: "0c339bdefb478f4f"}) SET n += {name: "咕噜肉-步骤6", description: "将梅头猪肉粒沾上生粉（6汤匙）。", stepNumber: "6"};
MERGE (n:CookingStep {nodeId: "20cc2b001f759ae2"}) SET n += {name: "咕噜肉-步骤7", description: "加入油（500毫升）中火加热。", stepNumber: "7", methods: "加热", tools: "锅"};
MERGE (n:CookingStep {nodeId: "4ef86bf834d01240"}) SET n += {name: "咕噜肉-步骤8", description: "将梅头猪肉粒放至锅里中火炸5分钟，然后盛起。", stepNumber: "8", methods: "炸", tools: "锅", timeEstimate: "5分钟"};
MERGE (n:CookingStep {nodeId: "1ac0b8da3d83f9ce"}) SET n += {name: "咕噜肉-步骤9", description: "加入梅头猪肉粒，再大火翻炸1分钟。", stepNumber: "9", methods: "炸", tools: "锅", timeEstimate: "1分钟"};
MERGE (n:CookingStep {nodeId: "3267734399f3ac24"}) SET n += {name: "咕噜肉-步骤10", description: "加入油（1茶匙）和酱汁，中火加热3分钟。", stepNumber: "10", methods: "加热", tools: "锅", timeEstimate: "3分钟"};
MERGE (n:CookingStep {nodeId: "8c1bb8a56b2a7ce1"}) SET n += {name: "咕噜肉-步骤11", description: "加入青椒和菠萝，大火加热2分钟。", stepNumber: "11", methods: "加热", tools: "锅", timeEstimate: "2分钟"};
MERGE (n:CookingStep {nodeId: "f70964f8e9b4073d"}) SET n += {name: "咕噜肉-步骤12", description: "将已炸好的梅头猪肉粒与酱汁拌匀即可。", stepNumber: "12", methods: "拌匀"};
MERGE (n:CookingStep {nodeId: "2ccc440d6a3a498f"}) SET n += {name: "咖喱炒蟹-步骤1", description: "肉蟹掀盖后对半砍开，蟹钳用刀背轻轻拍裂，切口和蟹钳蘸一下生粉。撒5g生粉到蟹盖中，盖住蟹黄，备用。", stepNumber: "1", tools: "刀"};
MERGE (n:CookingStep {nodeId: "0a2dc31a905c2a80"}) SET n += {name: "咖喱炒蟹-步骤2", description: "洋葱切成洋葱碎，备用。大蒜切碎，备用。烧一壶开水，备用。", stepNumber: "2", methods: "切", tools: "刀"};
MERGE (n:CookingStep {nodeId: "868040b1bd0c24e1"}) SET n += {name: "咖喱炒蟹-步骤3", description: "起锅烧油，倒入约20ml食用油，等待10秒让油温升高。", stepNumber: "3", tools: "锅", timeEstimate: "10秒"};
MERGE (n:CookingStep {nodeId: "2002170a60b29271"}) SET n += {name: "咖喱炒蟹-步骤4", description: "将螃蟹切口朝下，轻轻放入锅中，煎20秒封住蟹黄、蟹肉。然后翻面，每面煎10秒。煎完将螃蟹取出备用。", stepNumber: "4", methods: "煎", tools: "锅", timeEstimate: "40秒"};
MERGE (n:CookingStep {nodeId: "4ffc82ae3e26286d"}) SET n += {name: "咖喱炒蟹-步骤5", description: "将螃蟹盖放入锅中，用勺子舀起锅中热油泼到蟹盖中，煎封住蟹盖中的蟹黄，煎20秒后取出备用。", stepNumber: "5", methods: "煎", tools: "锅,勺子", timeEstimate: "20秒"};
MERGE (n:CookingStep {nodeId: "0282af5b488ea6b4"}) SET n += {name: "咖喱炒蟹-步骤6", description: "不用刷锅，再倒入10ml食用油，大火让油温升高至轻微冒烟，将大蒜末、洋葱碎倒入，炒10秒钟。", stepNumber: "6", methods: "炒", tools: "锅", timeEstimate: "10秒"};
MERGE (n:CookingStep {nodeId: "f7a3077ebe079f0e"}) SET n += {name: "咖喱炒蟹-步骤7", description: "将咖喱块放入锅中炒化（10秒），放入煎好的螃蟹，翻炒均匀。", stepNumber: "7", methods: "炒", tools: "锅", timeEstimate: "10秒"};
MERGE (n:CookingStep {nodeId: "33e98ead092c44f1"}) SET n += {name: "咖喱炒蟹-步骤8", description: "倒入开水300ml，焖煮3分钟。", stepNumber: "8", methods: "焖煮", tools: "锅", timeEstimate: "3分钟"};
MERGE (n:CookingStep {nodeId: "aa6e1ad6f3834504"}) SET n += {name: "咖喱炒蟹-步骤9", description: "焖煮完后，倒入椰浆和蛋清，关火，关火后不断翻炒，一直到酱汁变浓稠。出锅。", stepNumber: "9", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "272b6c85e8f92fee"}) SET n += {name: "响油鳝丝-步骤1", description: "将鳝鱼切成三段后切成细丝。加入0.5克胡椒粉、3克料酒搅拌均匀，再加入5克香油腌制。", stepNumber: "1", methods: "切，腌制", tools: "刀"};
MERGE (n:CookingStep {nodeId: "076d007fd5381a3e"}) SET n += {name: "响油鳝丝-步骤2", description: "热油滑锅。加入植物油，烧到6成热。加入一半蒜末和全部姜末，翻炒几下。", stepNumber: "2", methods: "滑锅，炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "5b5ad8adbe1ad341"}) SET n += {name: "响油鳝丝-步骤3", description: "加入鳝丝，中火爆炒30秒。边缘淋入10克料酒，翻炒几下。", stepNumber: "3", methods: "爆炒", tools: "炒锅", timeEstimate: "30秒"};
MERGE (n:CookingStep {nodeId: "40296e4a9696ff7d"}) SET n += {name: "响油鳝丝-步骤4", description: "加入生抽，炒匀。加入蚝油、老抽，翻炒几下。加入食用盐、白糖、3克胡椒粉，炒匀。", stepNumber: "4", methods: "炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "c977d956d17b4a5c"}) SET n += {name: "响油鳝丝-步骤5", description: "淀粉和水混合为水淀粉，倒入锅中，收汁至浓稠。", stepNumber: "5", methods: "收汁", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "6c69957bb9cf5356"}) SET n += {name: "响油鳝丝-步骤6", description: "装盘，撒上蒜蓉、葱花。", stepNumber: "6"};
