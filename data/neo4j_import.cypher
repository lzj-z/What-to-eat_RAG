MERGE (n:CookingStep {nodeId: "37191c5edc71129c"}) SET n += {name: "微波葱姜黑鳕鱼-步骤2", description: "取葱白切丝25g，姜去皮后切丝10g，混合在一起后分成两半，分别放在袋内鱼片上。", stepNumber: "2", methods: "切", tools: "刀"};
MERGE (n:CookingStep {nodeId: "6f94052d1ae544d8"}) SET n += {name: "微波葱姜黑鳕鱼-步骤3", description: "每个袋子倒入2.5mL料酒。", stepNumber: "3"};
