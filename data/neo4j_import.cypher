MERGE (n:CookingStep {nodeId: "e6f26f6000e1e84b"}) SET n += {name: "微波葱姜黑鳕鱼-步骤7", description: "取葱绿切细丝10g，姜去皮后切丝3g，混合后分成两份撒在鱼片上。", stepNumber: "7", methods: "切", tools: "刀"};
MERGE (n:CookingStep {nodeId: "e88855e7fe1f433c"}) SET n += {name: "微波葱姜黑鳕鱼-步骤8", description: "取花生油50mL，在小锅中加热至190℃。", stepNumber: "8", methods: "加热", tools: "小锅"};
MERGE (n:CookingStep {nodeId: "a386e4056b8a3ffe"}) SET n += {name: "微波葱姜黑鳕鱼-步骤9", description: "将热油淋到放有葱绿的鱼片上，立刻上桌。", stepNumber: "9", methods: "淋油"};
MERGE (n:CookingStep {nodeId: "69248c4d688f8689"}) SET n += {name: "油焖大虾-步骤1", description: "剪虾枪到根上，虾须虾爪都剪掉，沙包挑掉，开背虾线挑出来，洗净备用。", stepNumber: "1", tools: "剪刀"};
MERGE (n:CookingStep {nodeId: "6c8faa255bde3138"}) SET n += {name: "油焖大虾-步骤2", description: "炸料油：油温三成热放花椒，油热离火，放葱姜（不要让油变色最好）葱稍微变黄沥油。", stepNumber: "2", methods: "炸", tools: "锅"};
MERGE (n:CookingStep {nodeId: "473d72a4374b1aa9"}) SET n += {name: "油焖大虾-步骤3", description: "下油，虾摆放整齐，两面变色后轻轻摁虾头。", stepNumber: "3", methods: "煎", tools: "锅"};
MERGE (n:CookingStep {nodeId: "d4c7b77b0358d447"}) SET n += {name: "油焖大虾-步骤4", description: "放姜米（姜切成细颗粒）、黄酒30g、水两小碗、盐3g、冰糖10克。", stepNumber: "4"};
MERGE (n:CookingStep {nodeId: "b9daf6182518535b"}) SET n += {name: "油焖大虾-步骤5", description: "大火烧开转小火盖盖子闷（中途不能再加汤水，不要开盖）。", stepNumber: "5", methods: "焖", tools: "锅"};
MERGE (n:CookingStep {nodeId: "25813d09a8386e90"}) SET n += {name: "油焖大虾-步骤6", description: "皮亮虾弯就可以起锅，虾摆盘。", stepNumber: "6"};
