MERGE (n:CookingStep {nodeId: "d73259f339ad961a"}) SET n += {name: "小龙虾-步骤5", description: "下小龙虾，翻炒至变色。", stepNumber: "5", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "563e113c6a350c73"}) SET n += {name: "小龙虾-步骤6", description: "加入啤酒，等啤酒烧开后加入生抽，盐。", stepNumber: "6", methods: "煮", tools: "锅"};
MERGE (n:CookingStep {nodeId: "4985cb8bd1c96492"}) SET n += {name: "小龙虾-步骤7", description: "将小龙虾完全煮熟后出锅。", stepNumber: "7", methods: "煮", tools: "锅"};
