MERGE (n:CookingStep {nodeId: "61cf05b5097fad13"}) SET n += {name: "清蒸生蚝-步骤4", description: "关上烫锅盖，100%功率蒸3.5分钟。", stepNumber: "4", methods: "蒸", timeEstimate: "3.5分钟"};
MERGE (n:CookingStep {nodeId: "5093910b6b569d9c"}) SET n += {name: "清蒸生蚝-步骤5", description: "停火，用右手拿着抹布掀开烫锅盖，每个放5ml酱油。", stepNumber: "5", tools: "抹布"};
MERGE (n:CookingStep {nodeId: "26b69c73f14a85d5"}) SET n += {name: "清蒸生蚝-步骤6", description: "盛盘。", stepNumber: "6"};
MERGE (n:CookingStep {nodeId: "d3f2dac7db39a3a6"}) SET n += {name: "清蒸鲈鱼-步骤1", description: "姜切片切丝、香葱的葱白切段，葱绿切丝，切丝后放入冷水浸泡备用。", stepNumber: "1", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "e61afcedc3c55747"}) SET n += {name: "清蒸鲈鱼-步骤2", description: "鲈鱼处理好后洗净，用厨房纸擦干，两面分别划几刀，用盐洗掉鱼身的粘液，并用10g盐抹遍鱼身的内外，腌制10分钟以上。", stepNumber: "2", methods: "腌制", tools: "厨房纸", timeEstimate: "10分钟"};
MERGE (n:CookingStep {nodeId: "976d3298523eecb4"}) SET n += {name: "清蒸鲈鱼-步骤3", description: "鱼肚内塞上姜和葱白，鱼身也撒上姜和葱白，量为备用的一半。蒸鱼的碟子用筷子将鱼跟碟子隔开蒸。", stepNumber: "3", tools: "碟子，筷子"};
MERGE (n:CookingStep {nodeId: "e3ed0e224fcfd94f"}) SET n += {name: "清蒸鲈鱼-步骤4", description: "水烧热感觉到水温后放进入鱼。", stepNumber: "4"};
MERGE (n:CookingStep {nodeId: "f62673b3eb54a928"}) SET n += {name: "清蒸鲈鱼-步骤5", description: "大火清蒸10分钟。", stepNumber: "5", methods: "蒸", timeEstimate: "10分钟"};
MERGE (n:CookingStep {nodeId: "150b81ecd671c094"}) SET n += {name: "清蒸鲈鱼-步骤6", description: "蒸好的鱼，用干净的盘子装起来并去除身上姜蒜。", stepNumber: "6", tools: "盘子"};
MERGE (n:CookingStep {nodeId: "6927bf07ae8a9843"}) SET n += {name: "清蒸鲈鱼-步骤7", description: "鱼身浇上15ml蒸鱼豉油。", stepNumber: "7"};
MERGE (n:CookingStep {nodeId: "8e335339df5561a6"}) SET n += {name: "清蒸鲈鱼-步骤8", description: "鱼身重新撒上姜和葱丝，锅内加上10ml食用油并烧热，将食用油淋至鱼身即可出菜。", stepNumber: "8", methods: "淋油", tools: "锅"};
MERGE (n:CookingStep {nodeId: "d637cf980b3c2b5a"}) SET n += {name: "糖醋里脊-步骤1", description: "腌肉：将猪里脊肉先切厚片，用刀背拍一拍，把肉拍松一点。切成一个手指头粗的条，加料酒，生抽，蚝油，食盐，白胡椒粉，一个鸡蛋，将肉用手抓匀，腌制20分钟以上。", stepNumber: "1", methods: "腌制", tools: "刀", timeEstimate: "20分钟"};
MERGE (n:CookingStep {nodeId: "53a01c77774eaadc"}) SET n += {name: "糖醋里脊-步骤2", description: "调酱：番茄酱+10g醋+30g白糖+150ml清水，搅拌至糖融化，备用。", stepNumber: "2", methods: "搅拌"};
MERGE (n:CookingStep {nodeId: "6d0fe6d71fb2d85b"}) SET n += {name: "糖醋里脊-步骤3", description: "裹粉：准备一个大碗，里面放淀粉，把每一根肉条都满满裹上淀粉。", stepNumber: "3", tools: "碗"};
MERGE (n:CookingStep {nodeId: "14b76b6fd28f1ff6"}) SET n += {name: "糖醋里脊-步骤4", description: "炸制：油温160摄氏度下里脊，可以拿一个干筷子放在油里面试一下，周围冒小泡就可以下锅。炸到表面微黄可以捞出，全程中火。", stepNumber: "4", methods: "炸", tools: "锅"};
MERGE (n:CookingStep {nodeId: "9d44c85cc148b74a"}) SET n += {name: "糖醋里脊-步骤5", description: "复炸：等油温升高到200摄氏度，把里脊倒进去重新炸一次，只需40秒，表皮就会很脆，马上捞出。", stepNumber: "5", methods: "炸", tools: "锅", timeEstimate: "40秒"};
MERGE (n:CookingStep {nodeId: "1b70333f3519bf24"}) SET n += {name: "糖醋里脊-步骤6", description: "裹酱：另外拿一个锅，锅里放底油，把调好的酱汁倒进去，煮到冒泡，把炸好的里脊放进去，翻炒，让每一根都裹上酱汁。关火盛出。", stepNumber: "6", methods: "煮，炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "717f42445ecc2ca9"}) SET n += {name: "红烧鸡翅-步骤1", description: "将鸡翅洗净。用刀在鸡翅厚处划三刀，背面扎一刀，便于入味。如果鸡翅不新鲜，可在打完花刀之后用姜水泡10-20分钟。", stepNumber: "1", methods: "腌制", tools: "刀"};
MERGE (n:CookingStep {nodeId: "2917bdbbaed9986f"}) SET n += {name: "红烧鸡翅-步骤2", description: "将姜片、葱段备好；大蒜用刀拍散；香叶、八角、干辣椒整理好备用。", stepNumber: "2", methods: "准备", tools: "刀"};
MERGE (n:CookingStep {nodeId: "630998f0d57cc767"}) SET n += {name: "红烧鸡翅-步骤3", description: "锅中加入清水没过所有鸡翅，冷水下锅放入处理好的鸡翅，加入20ml黄酒或料酒、2片姜片，开大火烧至沸腾，沸腾后保持大火继续煮2-3分钟，撇去浮沫。", stepNumber: "3", methods: "焯水", tools: "锅", timeEstimate: "2-3分钟"};
MERGE (n:CookingStep {nodeId: "a921dc5e35cf6939"}) SET n += {name: "红烧鸡翅-步骤4", description: "煮好后将鸡翅捞出，用温水清洗2遍，彻底去除血沫，控干水分备用。", stepNumber: "4", methods: "清洗"};
MERGE (n:CookingStep {nodeId: "10730f950af38438"}) SET n += {name: "红烧鸡翅-步骤5", description: "另起锅，开火烧热后放入食用油。待油温至5成热，加入冰糖，开大火将冰糖熬至完全融化，冰糖融化变色后转小火，继续炒至冰糖呈枣红色。", stepNumber: "5", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "76aaa2051fdda7d1"}) SET n += {name: "红烧鸡翅-步骤6", description: "立即放入控干水分的鸡翅，快速翻炒1-2分钟，使每只鸡翅均匀裹上糖色。", stepNumber: "6", methods: "炒", tools: "锅", timeEstimate: "1-2分钟"};
MERGE (n:CookingStep {nodeId: "9ed943063c1f1b05"}) SET n += {name: "红烧鸡翅-步骤7", description: "加入准备好的香叶、八角、干辣椒、姜片、葱段、拍散的大蒜，继续煸炒30秒至香料香味完全释放。", stepNumber: "7", methods: "炒", tools: "锅", timeEstimate: "30秒"};
MERGE (n:CookingStep {nodeId: "7d71a871ab423441"}) SET n += {name: "红烧鸡翅-步骤8", description: "沿锅边淋入15ml料酒或黄酒，15ml生抽，快速翻炒10秒。", stepNumber: "8", methods: "炒", tools: "锅", timeEstimate: "10秒"};
MERGE (n:CookingStep {nodeId: "0da6e724f3a9feec"}) SET n += {name: "红烧鸡翅-步骤9", description: "加入温水（水温约50-60℃），水量以稍微没过所有鸡翅为准。加入老抽、盐、白糖、胡椒粉，用炒勺轻轻搅拌均匀。", stepNumber: "9", methods: "炖煮", tools: "锅,炒勺"};
MERGE (n:CookingStep {nodeId: "3096d2d944f2f2a8"}) SET n += {name: "红烧鸡翅-步骤10", description: "盖上锅盖，开中火烧煮7-8分钟。", stepNumber: "10", methods: "炖煮", tools: "锅", timeEstimate: "7-8分钟"};
MERGE (n:CookingStep {nodeId: "83d1797c78dfa12c"}) SET n += {name: "红烧鸡翅-步骤11", description: "打开锅盖，用筷子将锅中的香叶、八角、姜片、葱段、大蒜捡出丢弃。", stepNumber: "11", tools: "筷子"};
MERGE (n:CookingStep {nodeId: "384b265dab4b7044"}) SET n += {name: "红烧鸡翅-步骤12", description: "转大火，保持不断翻炒，将汤汁烧至粘稠状态（约1-2分钟）。", stepNumber: "12", methods: "收汁", tools: "锅", timeEstimate: "1-2分钟"};
MERGE (n:CookingStep {nodeId: "6290d9ad5e6ba8ec"}) SET n += {name: "红烧鸡翅-步骤13", description: "关火，将鸡翅盛入盘中，淋上锅中剩余的粘稠汤汁。最后撒上白芝麻和小葱花，完成制作。", stepNumber: "13", methods: "装盘", tools: "盘"};
MERGE (n:CookingStep {nodeId: "0b2e754026eae1ff"}) SET n += {name: "芥末黄油罗氏虾-步骤1", description: "将罗氏虾剪掉头尾尖刺、触须和脚，剪刀把虾身开背，去除虾线。", stepNumber: "1", tools: "剪刀"};
MERGE (n:CookingStep {nodeId: "a5dd4a908285b471"}) SET n += {name: "芥末黄油罗氏虾-步骤2", description: "提前搅拌好芥末酱汁：酱油、蚝油、芥末、盐、糖，搅拌均匀。", stepNumber: "2", methods: "搅拌"};
MERGE (n:CookingStep {nodeId: "b405b93b90858656"}) SET n += {name: "芥末黄油罗氏虾-步骤3", description: "洗好香菜，切段备用。", stepNumber: "3", methods: "切", tools: "刀"};
MERGE (n:CookingStep {nodeId: "d2e2f7afb488a9b0"}) SET n += {name: "芥末黄油罗氏虾-步骤4", description: "罗氏虾沥掉水，锅中加入油，直接放入罗氏虾，中火，外表煎至金黄，捞出。", stepNumber: "4", methods: "煎", tools: "锅"};
MERGE (n:CookingStep {nodeId: "573a02eefbb58f59"}) SET n += {name: "芥末黄油罗氏虾-步骤5", description: "下入蒜蓉，大火，利用煎虾剩下的油继续煎炒蒜蓉，等到锅中白雾冒出，蒜蓉已煎出香味，下虾和黄油，让虾吸收黄油香味。", stepNumber: "5", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "151bfddb723312be"}) SET n += {name: "芥末黄油罗氏虾-步骤6", description: "下入调好的酱汁，继续大火煮沸，翻炒虾，至酱汁收汁，加入酒（料酒、啤酒放30g，朗姆酒放15g）。", stepNumber: "6", methods: "煮,炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "68962c1ccbc8c622"}) SET n += {name: "芥末黄油罗氏虾-步骤7", description: "在等酱汁稍微收汁，加入香菜翻炒两下，即可出锅。", stepNumber: "7", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "7f1151fe709523e8"}) SET n += {name: "葱烧海参-步骤1", description: "葱白切成1cm的段，备用。", stepNumber: "1", methods: "切", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "44d6189e3d1134af"}) SET n += {name: "葱烧海参-步骤2", description: "海参切成1cm的段，备用。", stepNumber: "2", methods: "切", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "b8ea251589045a17"}) SET n += {name: "葱烧海参-步骤3", description: "准备一个空碗，倒入20g蚝油，10g生抽，2g白糖，搅拌均匀。", stepNumber: "3", methods: "搅拌", tools: "碗"};
MERGE (n:CookingStep {nodeId: "8a028a093254721b"}) SET n += {name: "葱烧海参-步骤4", description: "另一个空碗倒入淀粉，水，制备水淀粉，勾芡用。", stepNumber: "4", methods: "搅拌", tools: "碗"};
MERGE (n:CookingStep {nodeId: "4326d131888dafb7"}) SET n += {name: "葱烧海参-步骤5", description: "热锅，锅内放入20ml - 25ml食用油。等待10秒让油温升高。", stepNumber: "5", methods: "热锅", tools: "锅", timeEstimate: "10秒"};
MERGE (n:CookingStep {nodeId: "c1eba30d91d4335f"}) SET n += {name: "葱烧海参-步骤6", description: "放入葱白，调小火，注意不要让葱白变焦。大概煎3-5分钟即可。", stepNumber: "6", methods: "煎", tools: "锅", timeEstimate: "3-5分钟"};
MERGE (n:CookingStep {nodeId: "0a97f90267d726ff"}) SET n += {name: "葱烧海参-步骤7", description: "用筷子夹出葱白，放入盘中备用。", stepNumber: "7", tools: "筷子,盘"};
MERGE (n:CookingStep {nodeId: "8cb6f754f0c0bb7b"}) SET n += {name: "葱烧海参-步骤8", description: "倒入调好的料汁，炒香，等待1 - 2分钟。", stepNumber: "8", methods: "炒", tools: "锅", timeEstimate: "1-2分钟"};
MERGE (n:CookingStep {nodeId: "770dfa65c6776654"}) SET n += {name: "葱烧海参-步骤9", description: "放入切好的海参，翻炒1分钟。", stepNumber: "9", methods: "炒", tools: "锅", timeEstimate: "1分钟"};
MERGE (n:CookingStep {nodeId: "c9aa066b305acae1"}) SET n += {name: "葱烧海参-步骤10", description: "加入100 ml的水，中小火，等待5分钟。", stepNumber: "10", methods: "烧", tools: "锅", timeEstimate: "5分钟"};
MERGE (n:CookingStep {nodeId: "312a7be71516ce89"}) SET n += {name: "葱烧海参-步骤11", description: "等待锅中汤汁快干的时候，加入水淀粉，加入前面取出的葱白。", stepNumber: "11", methods: "勾芡", tools: "锅"};
MERGE (n:CookingStep {nodeId: "3ebc432ebf57f1c2"}) SET n += {name: "葱烧海参-步骤12", description: "在外观呈粘稠状态后关火，盛盘。", stepNumber: "12", tools: "锅,盘"};
MERGE (n:CookingStep {nodeId: "264ea5f278a6b297"}) SET n += {name: "西红柿炒鸡蛋-步骤1", description: "西红柿洗净。可选：去掉西红柿的外表皮（开水烫表皮，然后将西红柿放入冷水，剥去外皮）。西红柿去蒂，切成边长不超过4cm的小块，即为`西红柿块`。", stepNumber: "1", methods: "切", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "96969e8167937855"}) SET n += {name: "西红柿炒鸡蛋-步骤2", description: "将鸡蛋打入碗中，加入`1g * 份数`的盐，搅匀，即为`鸡蛋液`（可以考虑向鸡蛋中加入1ml醋，这可以去除腥味，令鸡蛋更蓬松）。", stepNumber: "2", methods: "搅拌", tools: "碗"};
MERGE (n:CookingStep {nodeId: "a34a53fa2602d5a7"}) SET n += {name: "西红柿炒鸡蛋-步骤3", description: "热锅，加入食用油。油热后，倒入`鸡蛋液`。翻炒至鸡蛋结为固体且颜色微微发黄，即为`半熟鸡蛋`。", stepNumber: "3", methods: "炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "62c4d2e0e8446282"}) SET n += {name: "西红柿炒鸡蛋-步骤4", description: "关火。将`半熟鸡蛋`盛盘，重新开火（注意：不要洗锅）。加入`西红柿块`，锅铲拍打并翻炒20秒，或至西红柿软烂。", stepNumber: "4", methods: "炒", tools: "炒锅,锅铲", timeEstimate: "20秒"};
MERGE (n:CookingStep {nodeId: "88b9ecc04fb20e26"}) SET n += {name: "西红柿炒鸡蛋-步骤5", description: "向锅中加入`半熟鸡蛋`，翻炒均匀（可以考虑加入10ml番茄酱和50ml清水，增加汤汁；可以额外加入一些其它熟肉和材料）。加入剩余的盐、糖（可选，如果倾向于甜味版本）、葱花（可选），翻炒均匀。关火，盛盘。", stepNumber: "5", methods: "炒", tools: "炒锅,锅铲"};
MERGE (n:CookingStep {nodeId: "f83a6a91795c22f2"}) SET n += {name: "辣椒炒肉-步骤1", description: "将青椒洗净，去除青椒把以及青椒籽，再用滚刀手法切好备用。", stepNumber: "1"};
MERGE (n:CookingStep {nodeId: "a0a9b0377287fdd5"}) SET n += {name: "辣椒炒肉-步骤2", description: "大蒜用刀拍一下，再横切成蒜瓣，生姜切碎成姜末。", stepNumber: "2", tools: "刀"};
MERGE (n:CookingStep {nodeId: "ff9634f07878e177"}) SET n += {name: "辣椒炒肉-步骤3", description: "将猪瘦肉切成肉片（顺着猪肉的纹理切，即刀和肉的纹理呈水平线，出来的肉片，纹路呈“川”字）。", stepNumber: "3", tools: "刀"};
MERGE (n:CookingStep {nodeId: "27ef45c4c334cdef"}) SET n += {name: "辣椒炒肉-步骤4", description: "将切好的猪肉洗净，放入空碗，再加入计算好的生抽、蚝油、盐搅拌均匀，腌制10分钟。", stepNumber: "4", methods: "腌制", tools: "碗", timeEstimate: "10分钟"};
MERGE (n:CookingStep {nodeId: "4a2251bda98770c4"}) SET n += {name: "辣椒炒肉-步骤5", description: "热锅，不用倒油，把切好的青椒放入锅中，大火干煸至虎皮状后，再加2g盐继续翻炒1分钟后捞起。", stepNumber: "5", methods: "干煸,炒", tools: "锅", timeEstimate: "1分钟"};
MERGE (n:CookingStep {nodeId: "ac160a00b132b562"}) SET n += {name: "辣椒炒肉-步骤6", description: "不用洗锅，大火热锅，加入份数 * 8ml油，等待30s，加入蒜瓣、姜末翻炒15s。", stepNumber: "6", methods: "炒", tools: "锅", timeEstimate: "45秒"};
MERGE (n:CookingStep {nodeId: "72baf82b6be102b9"}) SET n += {name: "辣椒炒肉-步骤7", description: "加入腌制好的猪肉倒入锅内翻炒2分钟，再加入干煸过的青椒翻炒1分钟。", stepNumber: "7", methods: "炒", tools: "锅", timeEstimate: "3分钟"};
MERGE (n:CookingStep {nodeId: "2972d47206fbc4e3"}) SET n += {name: "辣椒炒肉-步骤8", description: "根据个人口味喜好加入豆豉，最后加入酱油，继续翻炒30s。", stepNumber: "8", methods: "炒", tools: "锅", timeEstimate: "30秒"};
MERGE (n:CookingStep {nodeId: "9aae038aea46ea2d"}) SET n += {name: "辣椒炒肉-步骤9", description: "出锅，盛盘。", stepNumber: "9", tools: "盘"};
MERGE (n:CookingStep {nodeId: "59f8ec5a2ad1164e"}) SET n += {name: "鸡蛋火腿炒黄瓜-步骤1", description: "黄瓜洗净，切半圆形片，备用。火腿切半圆形片，备用。红尖椒（可选）切碎，备用。", stepNumber: "1", methods: "切", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "e7b473c240280df4"}) SET n += {name: "鸡蛋火腿炒黄瓜-步骤2", description: "将鸡蛋打入碗中，搅匀，即为鸡蛋液。", stepNumber: "2", tools: "碗"};
MERGE (n:CookingStep {nodeId: "9cf09a9e037999b8"}) SET n += {name: "鸡蛋火腿炒黄瓜-步骤3", description: "热锅里倒5ml食用油。油热后转小火，倒入打散的鸡蛋液，用筷子划散，翻炒至鸡蛋结为固体且颜色微微发黄，即为半熟鸡蛋，盛出备用。", stepNumber: "3", methods: "炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "d7bd416e5f02c434"}) SET n += {name: "鸡蛋火腿炒黄瓜-步骤4", description: "不用洗锅，往锅内倒入5ml食用油，倒入黄瓜片大火翻炒1分钟。", stepNumber: "4", methods: "炒", tools: "炒锅", timeEstimate: "1分钟"};
MERGE (n:CookingStep {nodeId: "e947fbda0fbf7163"}) SET n += {name: "鸡蛋火腿炒黄瓜-步骤5", description: "把半熟鸡蛋倒入锅中，调入2g盐、3ml生抽，立刻倒入火腿片和辣椒碎（可选）翻炒均匀。", stepNumber: "5", methods: "炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "d269f680284344e2"}) SET n += {name: "鸡蛋火腿炒黄瓜-步骤6", description: "关火，盛盘。", stepNumber: "6"};
MERGE (n:CookingStep {nodeId: "491fd61472f221e0"}) SET n += {name: "黄焖鸡-步骤1", description: "鸡腿洗净，剁成4cm大小的块。生姜切片、干辣椒切成小圈。香菇切片，青椒切成细长的马蹄状，若为干香菇，洗净灰尘后泡一晚上并留香菇水备用。若有土豆，切为与鸡肉大小类似的滚刀块。", stepNumber: "1", methods: "切", tools: "刀"};
MERGE (n:CookingStep {nodeId: "38e6b905737b2857"}) SET n += {name: "黄焖鸡-步骤2", description: "锅里倒入底油，冷油时放入白糖。小火慢慢加热，待油温逐渐升高，白糖开始融化并变成较深的棕色（期间要不断搅拌，防止糊锅）。", stepNumber: "2", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "1db5d273b3ab7760"}) SET n += {name: "黄焖鸡-步骤3", description: "迅速倒入鸡块，转大火，快速翻炒！烹入料酒，继续翻炒片刻。将生姜片和干辣椒倒入。放入酱油，炒匀。", stepNumber: "3", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "551d37cdc6cf1c77"}) SET n += {name: "黄焖鸡-步骤4", description: "倒入香菇水或清水，以能淹住鸡肉为准。倒入香菇片，白胡椒粉，盐，土豆。翻炒均匀后，盖上锅盖焖煮，转中小火15——20分钟，有条件可以转至砂锅。", stepNumber: "4", methods: "焖煮", tools: "锅,锅盖,砂锅", timeEstimate: "15-20分钟"};
MERGE (n:CookingStep {nodeId: "ca92db7265d13a42"}) SET n += {name: "黄焖鸡-步骤5", description: "待鸡肉软烂，汤汁浓稠后（汤汁不要收的太干），最后放入青椒。放入味精，兜炒均匀后，关火！青椒基本断生即可，不要炒时间久了。", stepNumber: "5", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "8099ad41821c039c"}) SET n += {name: "排骨苦瓜汤-步骤1", description: "排骨洗净，切到约4cm的小块。", stepNumber: "1", methods: "切", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "4ce604cfa13790ae"}) SET n += {name: "排骨苦瓜汤-步骤2", description: "炒锅倒入冷水700ml和排骨一起加热至煮沸，关火捞出排骨。", stepNumber: "2", methods: "焯水", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "34799a733222a722"}) SET n += {name: "排骨苦瓜汤-步骤3", description: "苦瓜中间切为两半，清除干净内部的种子和苦瓜瓤，切为0.5cm的苦瓜条，洗净。", stepNumber: "3", methods: "切", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "0056907f94360d80"}) SET n += {name: "排骨苦瓜汤-步骤4", description: "汤锅倒入水1100ml和排骨，大火。等待水沸腾后将苦瓜和虾皮下锅转小火，等待120~240分钟。", stepNumber: "4", methods: "炖", tools: "汤锅", timeEstimate: "120-240分钟"};
MERGE (n:CookingStep {nodeId: "4ec081bb3f1bf90d"}) SET n += {name: "排骨苦瓜汤-步骤5", description: "出锅时加盐和白胡椒，推荐量为每250ml 0.3到0.6g盐，0.1到0.5g白胡椒。", stepNumber: "5", methods: "调味"};
MERGE (n:CookingStep {nodeId: "eb1264a1ee4ec1e3"}) SET n += {name: "玉米排骨汤-步骤1", description: "大葱切成3-4cm的大段，用刀背拍一下。玉米剁成小块。胡萝卜切成滚刀块。生姜去皮切大片。新鲜的排骨砍成小块。", stepNumber: "1", methods: "切", tools: "刀"};
MERGE (n:CookingStep {nodeId: "5aa3aa853cfc155a"}) SET n += {name: "玉米排骨汤-步骤2", description: "排骨凉水下锅，放入大葱、生姜、料酒开始焯水，大火烧开，撇去浮沫，捞出排骨，沥干水分。", stepNumber: "2", methods: "焯水", tools: "锅"};
MERGE (n:CookingStep {nodeId: "360fa77fff98bd19"}) SET n += {name: "玉米排骨汤-步骤3", description: "热锅凉油，切大片的生姜和排骨一起下锅煸炒，待排骨表面微微焦黄，放入醋（可加速肉质软烂），继续煸炒一分钟。", stepNumber: "3", methods: "煸炒", tools: "锅", timeEstimate: "1分钟"};
MERGE (n:CookingStep {nodeId: "ce9f7b34887d10c6"}) SET n += {name: "玉米排骨汤-步骤4", description: "冲入开水，一次给足，之后就不要再加了，大火烧开。", stepNumber: "4", methods: "烧", tools: "锅"};
MERGE (n:CookingStep {nodeId: "424110f5eca66fa7"}) SET n += {name: "玉米排骨汤-步骤5", description: "先下入玉米，放入胡椒粉，盖盖小火炖二十分钟，然后放入胡萝卜，盖盖继续小火炖四十分钟。", stepNumber: "5", methods: "炖", tools: "砂锅,锅", timeEstimate: "60分钟"};
MERGE (n:CookingStep {nodeId: "6b3ee253c20e7763"}) SET n += {name: "玉米排骨汤-步骤6", description: "出锅前三分钟，除了盐什么都不用放，最后撒上一把小葱花即可。", stepNumber: "6", methods: "调味", timeEstimate: "3分钟"};
MERGE (n:CookingStep {nodeId: "61d72977e7d9e184"}) SET n += {name: "紫菜蛋花汤-步骤1", description: "干紫菜用清水泡15分钟，捞起沥干水份备用。", stepNumber: "1", methods: "浸泡", timeEstimate: "15分钟"};
MERGE (n:CookingStep {nodeId: "8d16e33bde074bbf"}) SET n += {name: "紫菜蛋花汤-步骤2", description: "热锅，倒入1.5升清水、5ml油、2g盐。待水开后放入紫菜。", stepNumber: "2", methods: "煮", tools: "锅"};
MERGE (n:CookingStep {nodeId: "6c60a6a60c470553"}) SET n += {name: "紫菜蛋花汤-步骤3", description: "紫菜烧开后3分钟，将打好的蛋液徐徐倒入锅内，30秒既可起锅。", stepNumber: "3", methods: "煮", tools: "锅", timeEstimate: "3分30秒"};
MERGE (n:CookingStep {nodeId: "dd6480e2b760788a"}) SET n += {name: "紫菜蛋花汤-步骤4", description: "撒上葱花，转小火20秒。", stepNumber: "4", methods: "煮", tools: "锅", timeEstimate: "20秒"};
MERGE (n:CookingStep {nodeId: "564a8d42f85092f0"}) SET n += {name: "紫菜蛋花汤-步骤5", description: "关火，出锅前放入几滴香油，也有的会放入一点虾皮，味道也不错。", stepNumber: "5"};
MERGE (n:CookingStep {nodeId: "ecd933fa92ebaa43"}) SET n += {name: "羊肉汤-步骤1", description: "羊肉切成长5cm宽0.5cm的块。大葱切成小段。", stepNumber: "1", methods: "切", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "51b97ccdfecb4300"}) SET n += {name: "羊肉汤-步骤2", description: "羊肉放入锅中，加入1000ml常温水，加入料酒、大葱。煮沸2分钟后，捞出羊肉，使用常温水洗净，沥干水分。", stepNumber: "2", methods: "焯水", tools: "锅", timeEstimate: "2分钟"};
MERGE (n:CookingStep {nodeId: "0a8abf3a2a469aa6"}) SET n += {name: "羊肉汤-步骤3", description: "热锅加入食用油，加入羊肉，翻炒2分钟至羊肉表面微黄。", stepNumber: "3", methods: "炒", tools: "锅", timeEstimate: "2分钟"};
MERGE (n:CookingStep {nodeId: "828139362ff71453"}) SET n += {name: "羊肉汤-步骤4", description: "加入开水，开到大火档位。5分钟后，加入白胡椒粉、盐，继续煮沸5分钟。", stepNumber: "4", methods: "煮", tools: "锅", timeEstimate: "10分钟"};
MERGE (n:CookingStep {nodeId: "73879902023c0251"}) SET n += {name: "羊肉汤-步骤5", description: "出锅之后，加入香菜、孜然粉，搅拌均匀。", stepNumber: "5", methods: "搅拌"};
MERGE (n:CookingStep {nodeId: "9985bde4659f8be0"}) SET n += {name: "菌菇炖乳鸽-步骤1", description: "冷水洗干净热心摊主处理好的乳鸽。", stepNumber: "1", methods: "清洗"};
MERGE (n:CookingStep {nodeId: "16da71db190301ba"}) SET n += {name: "菌菇炖乳鸽-步骤2", description: "冷水锅中放入洗干净的乳鸽，加入15ml料酒与姜，水煮开即可捞出乳鸽，要不然会丢失营养。", stepNumber: "2", methods: "焯水", tools: "锅"};
MERGE (n:CookingStep {nodeId: "1173125ddf1fbad2"}) SET n += {name: "菌菇炖乳鸽-步骤3", description: "把乳鸽放到高压锅或者瓦罐中、倒入的水要没过乳鸽，放入生姜20g，玉米200g、菌菇100g。注意：高压锅30分钟，瓦罐需在水烧开后转小火慢炖40-60分钟。", stepNumber: "3", methods: "炖", tools: "高压锅,瓦罐", timeEstimate: "30-60分钟"};
MERGE (n:CookingStep {nodeId: "f0f8401b34613b1c"}) SET n += {name: "菌菇炖乳鸽-步骤4", description: "时间到了，盛到碗中，加入3~5g盐即可。", stepNumber: "4", methods: "调味"};
MERGE (n:CookingStep {nodeId: "326782839c2b3177"}) SET n += {name: "凉拌金针菇-步骤1", description: "将金针菇根部切除，用清水冲洗干净，备用。", stepNumber: "1"};
MERGE (n:CookingStep {nodeId: "b3e592edc8e202dd"}) SET n += {name: "凉拌金针菇-步骤2", description: "将小葱洗净，切成葱花，备用。", stepNumber: "2"};
MERGE (n:CookingStep {nodeId: "1326d22c02a855a6"}) SET n += {name: "凉拌金针菇-步骤3", description: "将大蒜去皮，切成蒜末，备用。", stepNumber: "3"};
MERGE (n:CookingStep {nodeId: "4327b37fa6971517"}) SET n += {name: "凉拌金针菇-步骤4", description: "锅中加入1000 ml饮用水，大火烧开。", stepNumber: "4", tools: "锅"};
MERGE (n:CookingStep {nodeId: "767910bf309209f7"}) SET n += {name: "凉拌金针菇-步骤5", description: "放入金针菇，煮1-2分钟，至金针菇变软。", stepNumber: "5", methods: "焯水", tools: "锅", timeEstimate: "1-2分钟"};
MERGE (n:CookingStep {nodeId: "ebbb1a0b9e70cbf8"}) SET n += {name: "凉拌金针菇-步骤6", description: "将煮好的金针菇捞出，沥干水分，放入一个较大的碗中，备用。", stepNumber: "6"};
MERGE (n:CookingStep {nodeId: "739e2d0982bbcd43"}) SET n += {name: "凉拌金针菇-步骤7", description: "在另一个干净的小碗中，加入15 ml生抽，10 ml醋，3 g白糖（可选），5 ml香油（可选）。", stepNumber: "7", tools: "碗"};
MERGE (n:CookingStep {nodeId: "1850682df0498f0d"}) SET n += {name: "凉拌金针菇-步骤8", description: "加入切好的大蒜末。", stepNumber: "8"};
MERGE (n:CookingStep {nodeId: "f445597727b99b6a"}) SET n += {name: "凉拌金针菇-步骤9", description: "搅拌均匀，使白糖充分溶解，酱汁混合均匀。", stepNumber: "9"};
MERGE (n:CookingStep {nodeId: "f24427900e9df1c1"}) SET n += {name: "凉拌金针菇-步骤10", description: "将制作好的酱汁均匀淋在金针菇上。", stepNumber: "10"};
MERGE (n:CookingStep {nodeId: "6ad42fcc23d9d172"}) SET n += {name: "凉拌金针菇-步骤11", description: "撒上切好的小葱花。", stepNumber: "11"};
MERGE (n:CookingStep {nodeId: "e1b9c2430564a356"}) SET n += {name: "凉拌金针菇-步骤12", description: "根据个人喜好，淋上5 ml辣椒油（可选）。", stepNumber: "12"};
MERGE (n:CookingStep {nodeId: "9b7a3411fd64b122"}) SET n += {name: "凉拌金针菇-步骤13", description: "用筷子轻轻拌匀，即可食用。", stepNumber: "13", tools: "筷子"};
MERGE (n:CookingStep {nodeId: "17be33197573887b"}) SET n += {name: "地三鲜-步骤1", description: "土豆、茄子、尖椒洗净。土豆去皮。茄子、土豆均切成15g的不规则小块。尖椒用手顺着纹路撕成比土豆、茄子略大25%的块。尽可能除去青椒表面水分。葱切0.5cm小段取5g。蒜剁碎成蒜蓉取15g，分成两份。姜切沫取5g。拿空碗放入生抽10ml、糖10g、淀粉8g，加入80ml清水，彻底搅拌均匀，作为调料碗备用。", stepNumber: "1", methods: "切，撕，搅拌", tools: "菜刀，碗"};
MERGE (n:CookingStep {nodeId: "5be87a05d45cb7a4"}) SET n += {name: "地三鲜-步骤2", description: "热锅，加入150ml油。加入土豆，煎炸大约3-4分钟，以显示金黄色、筷子能轻松扎透为准。捞出土豆，留下油。", stepNumber: "2", methods: "煎，炸", tools: "锅", timeEstimate: "3-4分钟"};
MERGE (n:CookingStep {nodeId: "5296f6400f6f0fc8"}) SET n += {name: "地三鲜-步骤3", description: "加入茄子，煎炸大约2-3分钟，待其到大约7分熟，以茄子变软、边缘微焦且吐出多余油脂为准。捞出茄子，留下油。", stepNumber: "3", methods: "煎，炸", tools: "锅", timeEstimate: "2-3分钟"};
MERGE (n:CookingStep {nodeId: "f153e593f21fdbea"}) SET n += {name: "地三鲜-步骤4", description: "如果锅内已无流动的油，可补充15ml油。加入尖椒块，煎炸大约15秒，边缘稍微起虎皮后，立刻捞出。倒出锅里的油。", stepNumber: "4", methods: "煎，炸", tools: "锅", timeEstimate: "15秒"};
MERGE (n:CookingStep {nodeId: "359e0d7c70b931f0"}) SET n += {name: "地三鲜-步骤5", description: "重新热锅，重新加入15ml新底油。放入葱5g，姜5g，蒜7.5g。中小火爆香。放入豆瓣酱15ml。转小火，炒出红油和酱香味。", stepNumber: "5", methods: "爆香，炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "3da66af1a1bcc2b7"}) SET n += {name: "地三鲜-步骤6", description: "倒入调料碗。立刻转大火，高速搅拌避免糊锅！大约10秒后汤汁开始冒泡并变得黏稠。立刻放入之前准备好的全部土豆、茄子和尖椒。翻炒20秒，让浓稠的酱汁均匀挂在食材上。关火，撒入7.5g蒜。翻拌均匀，盛盘。", stepNumber: "6", methods: "搅拌，翻炒", tools: "锅", timeEstimate: "30秒"};
MERGE (n:CookingStep {nodeId: "6c9002a87b8c3236"}) SET n += {name: "手撕包菜-步骤1", description: "包菜对半切开，去掉中间白色部分。", stepNumber: "1"};
MERGE (n:CookingStep {nodeId: "70c20994aa9f1287"}) SET n += {name: "手撕包菜-步骤2", description: "手撕包菜，碗中放入 2 g 盐，清洗包菜并沥干备用。", stepNumber: "2", methods: "清洗", tools: "碗"};
MERGE (n:CookingStep {nodeId: "7626cf88fb704199"}) SET n += {name: "手撕包菜-步骤3", description: "姜片、蒜头、小米辣、蒜苗处理后备用。", stepNumber: "3"};
MERGE (n:CookingStep {nodeId: "7b7fe6771a46d61f"}) SET n += {name: "手撕包菜-步骤4", description: "五花肉切片，清水清洗后备用。", stepNumber: "4", methods: "清洗"};
MERGE (n:CookingStep {nodeId: "a4410f3bf12c56ec"}) SET n += {name: "手撕包菜-步骤5", description: "锅中加入 30 ml 食用油，倒入包菜翻炒，大火翻炒 1 分钟后，加入 3 g 盐 ，继续翻炒 2 分钟后取出备用。", stepNumber: "5", methods: "炒", tools: "锅", timeEstimate: "3分钟"};
MERGE (n:CookingStep {nodeId: "201d4e39713b8f03"}) SET n += {name: "手撕包菜-步骤6", description: "锅中加入 30 ml 食用油，倒入五花肉，大火翻炒 1 分钟。", stepNumber: "6", methods: "炒", tools: "锅", timeEstimate: "1分钟"};
MERGE (n:CookingStep {nodeId: "7a9f09360dc2e555"}) SET n += {name: "手撕包菜-步骤7", description: "倒入姜片等材料，翻炒 1 分钟。", stepNumber: "7", methods: "炒", tools: "锅", timeEstimate: "1分钟"};
MERGE (n:CookingStep {nodeId: "9d548fb7bb2ffad4"}) SET n += {name: "手撕包菜-步骤8", description: "倒入包菜翻炒后，加入 香醋、料酒、鸡精、料酒，大火继续翻炒，2 分钟后出锅。", stepNumber: "8", methods: "炒", tools: "锅", timeEstimate: "2分钟"};
MERGE (n:CookingStep {nodeId: "a591c065d4c95de6"}) SET n += {name: "炒青菜-步骤1", description: "青菜掰成小瓣，用清水洗净，备用。", stepNumber: "1"};
MERGE (n:CookingStep {nodeId: "2002715dfe260d7a"}) SET n += {name: "炒青菜-步骤2", description: "将蒜瓣剁碎，备用。", stepNumber: "2"};
MERGE (n:CookingStep {nodeId: "c258a9efaa7bdcbc"}) SET n += {name: "炒青菜-步骤3", description: "中火或大火热锅后，锅内放入10-15ml食用油。再等待30秒让油温升高。", stepNumber: "3", methods: "炒", tools: "锅", timeEstimate: "30秒"};
MERGE (n:CookingStep {nodeId: "017c908348e5abb4"}) SET n += {name: "炒青菜-步骤4", description: "将准备好的青菜倒入锅中，翻炒至青菜变软（约1分钟）。", stepNumber: "4", methods: "炒", tools: "锅", timeEstimate: "1分钟"};
MERGE (n:CookingStep {nodeId: "080cd0c96e24a9c5"}) SET n += {name: "炒青菜-步骤5", description: "放入剁碎的蒜瓣。", stepNumber: "5", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "3b76d1dd8bbad3da"}) SET n += {name: "炒青菜-步骤6", description: "倒入计算好的清水，水位应当完全浸润或即将没过青菜，加入食盐（2g * 份数），继续翻炒约1分钟。", stepNumber: "6", methods: "炒", tools: "锅", timeEstimate: "1分钟"};
MERGE (n:CookingStep {nodeId: "a1300c1a2954a260"}) SET n += {name: "炒青菜-步骤7", description: "最后加入白糖小火加热2分钟，加热时盖上锅盖。", stepNumber: "7", methods: "煮", tools: "锅，锅盖", timeEstimate: "2分钟"};
MERGE (n:CookingStep {nodeId: "edb2419891987c78"}) SET n += {name: "炒青菜-步骤8", description: "盛盘。", stepNumber: "8"};
MERGE (n:CookingStep {nodeId: "2d8c74bc658e91e8"}) SET n += {name: "白灼菜心-步骤1", description: "菜心洗净，去除根部比较硬或老的地方。用刀刮掉菜心根茎部分外面那层比较硬的皮。", stepNumber: "1", methods: "处理", tools: "刀"};
MERGE (n:CookingStep {nodeId: "6aba981b9dad68a4"}) SET n += {name: "白灼菜心-步骤2", description: "大蒜切成蒜末。", stepNumber: "2", methods: "切", tools: "刀"};
MERGE (n:CookingStep {nodeId: "c55301a7f2eead09"}) SET n += {name: "白灼菜心-步骤3", description: "调制料汁：将生抽、蚝油、糖和清水混合成一碗汁。", stepNumber: "3", methods: "调制"};
MERGE (n:CookingStep {nodeId: "fa564ebc1fa055a1"}) SET n += {name: "白灼菜心-步骤4", description: "一锅清水加盐和食用油烧开。", stepNumber: "4", methods: "烧水", tools: "锅"};
MERGE (n:CookingStep {nodeId: "1b95aea324dc3e85"}) SET n += {name: "白灼菜心-步骤5", description: "将菜心根茎在沸水中烫1分钟，直到根茎颜色变成深绿。再将整个菜心放到锅中烫熟1分钟，捞起来码入盘中。", stepNumber: "5", methods: "焯水", tools: "锅", timeEstimate: "2分钟"};
MERGE (n:CookingStep {nodeId: "75b86e54d44dbabc"}) SET n += {name: "白灼菜心-步骤6", description: "开另一小锅，将兑好的料汁倒入，小火烧开，放入一半的蒜末、姜丝和小米椒碎。也可先在锅底倒油，爆香蒜末、洋葱后再加入料汁煮开。", stepNumber: "6", methods: "煮", tools: "锅"};
MERGE (n:CookingStep {nodeId: "eb6217487576e649"}) SET n += {name: "白灼菜心-步骤7", description: "料汁稍微收汁，煮沸后稍等十来秒，直接浇在菜心上。", stepNumber: "7", methods: "浇汁"};
MERGE (n:CookingStep {nodeId: "c4bebcba3f71fd65"}) SET n += {name: "蒲烧茄子-步骤1", description: "茄子削皮、横着切成两段。", stepNumber: "1", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "f1815624f8ecfb7d"}) SET n += {name: "蒲烧茄子-步骤2", description: "蒸5分钟。", stepNumber: "2", methods: "蒸", tools: "蒸锅", timeEstimate: "5分钟"};
MERGE (n:CookingStep {nodeId: "2a39db57bb5b7c8c"}) SET n += {name: "蒲烧茄子-步骤3", description: "纵向切开，不要切断，在两边切面各划2~3刀至可以摊平。", stepNumber: "3", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "11f217664d653798"}) SET n += {name: "蒲烧茄子-步骤4", description: "煎至两面金黄。", stepNumber: "4", methods: "煎", tools: "不粘锅或铁锅"};
MERGE (n:CookingStep {nodeId: "41d097d9e8119cfb"}) SET n += {name: "蒲烧茄子-步骤5", description: "往茄子上浇蒲烧汁至没过1/2茄子高度。", stepNumber: "5"};
MERGE (n:CookingStep {nodeId: "0021bef03dc4f5c5"}) SET n += {name: "蒲烧茄子-步骤6", description: "煎至背面上色，翻面，同时收汁，若无法收汁可以加入水淀粉（生粉和水的比例在1:4到1:10根据收汁情况而定）。", stepNumber: "6", methods: "煎，收汁", tools: "锅"};
MERGE (n:CookingStep {nodeId: "1acc6097fa10b10a"}) SET n += {name: "蒲烧茄子-步骤7", description: "把剩下的蒲烧汁浇在茄子上。", stepNumber: "7"};
MERGE (n:CookingStep {nodeId: "daf25d1b4b0ba3ae"}) SET n += {name: "蒲烧茄子-步骤8", description: "出锅，一份茄子烧蒲烧汁就烧好了。", stepNumber: "8"};
MERGE (n:CookingStep {nodeId: "7103cde0cc34876a"}) SET n += {name: "冬瓜茶-步骤1", description: "准备冬瓜：将冬瓜去皮，去籽，切成小块（每块不超过 4cm）。", stepNumber: "1", methods: "切", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "f3f106e38e94bba7"}) SET n += {name: "冬瓜茶-步骤2", description: "加入冰糖：冬瓜加入冰糖，搅拌均匀，盖上保鲜膜放冰箱冷藏 2 小时以上。", stepNumber: "2", methods: "搅拌,冷藏", tools: "保鲜膜", timeEstimate: "2小时以上"};
MERGE (n:CookingStep {nodeId: "9b7cf29adb32280d"}) SET n += {name: "冬瓜茶-步骤3", description: "煮冬瓜： 此时冬瓜出了很多水, 倒入锅中 大火煮开，然后转中小火慢慢熬制 1~2 个小时，中途多搅拌防止糊锅。", stepNumber: "3", methods: "煮,熬制", tools: "大锅", timeEstimate: "1-2小时"};
MERGE (n:CookingStep {nodeId: "18df50d2d7deacc7"}) SET n += {name: "冬瓜茶-步骤4", description: "过滤冬瓜茶：使用过滤网将煮好的冬瓜茶液过滤，取出冬瓜块，只保留茶液。", stepNumber: "4", methods: "过滤", tools: "过滤网"};
MERGE (n:CookingStep {nodeId: "0fcd353602a74508"}) SET n += {name: "冬瓜茶-步骤5", description: "冷却：将冬瓜茶液放凉后，倒入干净的容器中，放入冰箱冷藏即可。", stepNumber: "5", methods: "冷却,冷藏", tools: "容器"};
MERGE (n:CookingStep {nodeId: "45be23d4ca59b5cc"}) SET n += {name: "冰粉-步骤1", description: "将凉白开倒入盆中。", stepNumber: "1", tools: "盆"};
MERGE (n:CookingStep {nodeId: "333599ce541af0f2"}) SET n += {name: "冰粉-步骤2", description: "将冰粉籽全部用纱布包起来，开口处打结。", stepNumber: "2", tools: "纱布"};
MERGE (n:CookingStep {nodeId: "a2a6fde93fcf669d"}) SET n += {name: "冰粉-步骤3", description: "将包好的冰粉籽放入凉白开中，在凉白开中用力揉搓6分钟。", stepNumber: "3", methods: "揉搓", timeEstimate: "6分钟"};
MERGE (n:CookingStep {nodeId: "11bce05461a4723b"}) SET n += {name: "冰粉-步骤4", description: "然后将凉白开放置2.5小时，即可成型。", stepNumber: "4", methods: "静置", timeEstimate: "2.5小时"};
MERGE (n:CookingStep {nodeId: "ffc0649e5b0afcaa"}) SET n += {name: "冰粉-步骤5", description: "随后将石凉粉用勺子装进准备好的一次性透明塑料杯中，加入10ml薄荷汁或者10g薄荷粉（柠檬汁、山楂汁、桑椹汁也可），再放入遇水发光冰块，用勺子慢慢搅拌均匀。", stepNumber: "5", methods: "搅拌", tools: "勺子，一次性透明塑料杯"};
MERGE (n:CookingStep {nodeId: "b688d847930acebb"}) SET n += {name: "杨枝甘露-步骤1", description: "奇亚籽泡牛奶 10 分钟。", stepNumber: "1", methods: "泡", tools: "杯子", timeEstimate: "10分钟"};
MERGE (n:CookingStep {nodeId: "e029a9b41a14412a"}) SET n += {name: "杨枝甘露-步骤2", description: "泡籽之时，把半粒芒果、葡萄柚去皮切丁，放入杯中。", stepNumber: "2", methods: "切", tools: "水果刀,杯子"};
MERGE (n:CookingStep {nodeId: "376a6aefcb16b49a"}) SET n += {name: "杨枝甘露-步骤3", description: "半粒芒果切小块放入调理机加冰块、椰奶打成泥。", stepNumber: "3", methods: "打", tools: "调理机"};
MERGE (n:CookingStep {nodeId: "7d0de73d519a051e"}) SET n += {name: "杨枝甘露-步骤4", description: "倒入杯中，放上点缀材料（如有）。", stepNumber: "4", tools: "杯子"};
MERGE (n:CookingStep {nodeId: "26547dc43ed8388d"}) SET n += {name: "柠檬水-步骤1", description: "称40~45克柠檬，放入雪克杯中", stepNumber: "1", tools: "雪克杯"};
MERGE (n:CookingStep {nodeId: "b97f80ba738c9852"}) SET n += {name: "柠檬水-步骤2", description: "雪克杯盖盖子锤大约10次", stepNumber: "2", tools: "雪克杯"};
MERGE (n:CookingStep {nodeId: "946201193b1620bf"}) SET n += {name: "柠檬水-步骤3", description: "加入果蜜40~45克", stepNumber: "3"};
MERGE (n:CookingStep {nodeId: "aabc6498cc0823e2"}) SET n += {name: "柠檬水-步骤4", description: "补水", stepNumber: "4"};
MERGE (n:CookingStep {nodeId: "dcb3e81ca62e05dc"}) SET n += {name: "柠檬水-步骤5", description: "摇晃均匀", stepNumber: "5", tools: "雪克杯"};
MERGE (n:CookingStep {nodeId: "dcb1d865f6d18fdd"}) SET n += {name: "柠檬水-步骤6", description: "最后根据喜好加冰", stepNumber: "6"};
MERGE (n:CookingStep {nodeId: "ff1d7aa07171c9f7"}) SET n += {name: "酸梅汤-步骤1", description: "冲洗材料（干桂花和冰糖除外），用1.5升水常温浸泡两小时以上。", stepNumber: "1", methods: "浸泡", timeEstimate: "2小时以上"};
MERGE (n:CookingStep {nodeId: "ed5941d4990b1656"}) SET n += {name: "酸梅汤-步骤2", description: "开中大火煮沸，盖盖，转小火煮40分钟，为头煎。", stepNumber: "2", methods: "煮", tools: "锅", timeEstimate: "40分钟"};
MERGE (n:CookingStep {nodeId: "884057e6363db4db"}) SET n += {name: "酸梅汤-步骤3", description: "将冰糖放入盆内，再将沥好用材的头汤趁热倒入，搅拌至冰糖融化。", stepNumber: "3", methods: "搅拌", tools: "盆"};
MERGE (n:CookingStep {nodeId: "e909c36f34182d41"}) SET n += {name: "酸梅汤-步骤4", description: "药材重新装回锅内再加600毫升的水，开大火煮沸，盖盖，转中火，再煮20分钟为二煎。", stepNumber: "4", methods: "煮", tools: "锅", timeEstimate: "20分钟"};
MERGE (n:CookingStep {nodeId: "9ef704a45b1324b5"}) SET n += {name: "酸梅汤-步骤5", description: "将二煎和冰糖水趁热混合为成品。在成品60-70℃加入干桂花（不要超过80℃）加盖晾凉再放入冰箱冷藏3小时以上。", stepNumber: "5", methods: "混合，冷藏", tools: "冰箱", timeEstimate: "3小时以上"};
MERGE (n:CookingStep {nodeId: "b812b39be876a204"}) SET n += {name: "酸梅汤-步骤6", description: "饮用时记得将干桂花沥出。如饮茶般细啜，冰凉振齿，酸醒人、甜适度，滋味丰满而悠长。", stepNumber: "6"};
MERGE (n:CookingStep {nodeId: "8c34139cb8984d46"}) SET n += {name: "长岛冰茶-步骤1", description: "柠檬对半切，挤出30ml柠檬汁至杯中。", stepNumber: "1", methods: "榨汁", tools: "高球杯"};
MERGE (n:CookingStep {nodeId: "b3e5e843cbf599ba"}) SET n += {name: "长岛冰茶-步骤2", description: "依次向杯中加入15ml金酒、15ml龙舌兰酒、15ml伏特加、15ml白朗姆酒、15ml橙味甜酒。", stepNumber: "2", tools: "高球杯"};
MERGE (n:CookingStep {nodeId: "debe0fed84eea37f"}) SET n += {name: "长岛冰茶-步骤3", description: "向杯中缓慢倒入20ml枫糖浆，边倒边搅拌。", stepNumber: "3", methods: "搅拌"};
MERGE (n:CookingStep {nodeId: "885d407b537c84b7"}) SET n += {name: "长岛冰茶-步骤4", description: "向杯中加入75ml可乐。", stepNumber: "4", tools: "高球杯"};
MERGE (n:CookingStep {nodeId: "10ac01d93a798ef3"}) SET n += {name: "长岛冰茶-步骤5", description: "向杯中加入冰块直至满杯。", stepNumber: "5", tools: "高球杯"};
MERGE (n:CookingStep {nodeId: "0fa75c3a4f26ada9"}) SET n += {name: "长岛冰茶-步骤6", description: "轻轻搅拌20秒。", stepNumber: "6", methods: "搅拌", timeEstimate: "20秒"};
MERGE (n:CookingStep {nodeId: "4cae28c8f47dc509"}) SET n += {name: "意式肉酱面-步骤1", description: "锅中加水，烧开后放入意面（等待6 - 12分钟）。", stepNumber: "1", methods: "煮", tools: "锅", timeEstimate: "6-12分钟"};
MERGE (n:CookingStep {nodeId: "3d7c003319784c92"}) SET n += {name: "意式肉酱面-步骤2", description: "洋葱切成小丁。", stepNumber: "2", methods: "切", tools: "刀"};
MERGE (n:CookingStep {nodeId: "8041026d5081849e"}) SET n += {name: "意式肉酱面-步骤3", description: "空锅中倒油，中火下入洋葱碎，时刻搅拌，注意不要让洋葱烧糊，直到洋葱变成半透明状。", stepNumber: "3", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "4d6ddb3f9123c90d"}) SET n += {name: "意式肉酱面-步骤4", description: "下入肉沫，继续搅拌（搅散），直到肉末变成棕色。", stepNumber: "4", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "631745cd7274f857"}) SET n += {name: "意式肉酱面-步骤5", description: "加入意大利面酱，稍微搅拌一下即可。", stepNumber: "5", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "219663b23052ce6d"}) SET n += {name: "意式肉酱面-步骤6", description: "把煮好的意大利面沥干水分并倒入肉酱中搅拌均匀即可（或者直接把做好的肉酱倒在意面上也行）。", stepNumber: "6", methods: "沥干，搅拌"};
MERGE (n:CookingStep {nodeId: "e2d17a64f20641d2"}) SET n += {name: "手工水饺-步骤1", description: "盆中加入所有面粉，加入芝麻香油。面粉中央挖小洞，分4-5次加入水并搅和，当出现碎末状的稍微干燥面团时取消加水，用手将面团压实。面团压实至可把盆周围的面粉纳入即可（面光盆光）。", stepNumber: "1", methods: "和面", tools: "盆"};
MERGE (n:CookingStep {nodeId: "468dad2fcb14ab8e"}) SET n += {name: "手工水饺-步骤2", description: "将面团置于桌上，盆倒扣于桌上，在环境温度25度下使面团醒发约45分钟。", stepNumber: "2", methods: "醒发", tools: "盆", timeEstimate: "45分钟"};
MERGE (n:CookingStep {nodeId: "1365b41102026e8a"}) SET n += {name: "手工水饺-步骤3", description: "醒发完成后，将面团搓成条状，合成一团，再次搓成条，重复3次。擀成条状，切成20份均匀大小面团，并搓成直径约3-3.5cm的球状。", stepNumber: "3", methods: "揉面，分割"};
MERGE (n:CookingStep {nodeId: "649731f804b8795c"}) SET n += {name: "手工水饺-步骤4", description: "压扁面团，在手上、桌上、擀面杖上及面团上撒上面粉防止发粘。用擀面杖将面团擀平，约8cm直径，厚约2mm，中间略微比四周厚1mm。", stepNumber: "4", methods: "擀皮", tools: "擀面杖"};
MERGE (n:CookingStep {nodeId: "0883e6a4ce14e55c"}) SET n += {name: "手工水饺-步骤5", description: "猪肉去皮，保留部分肥肉，切成小块。用菜刀（建议两把）将猪肉剁成肉沫，放入碗中。", stepNumber: "5", methods: "切，剁", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "048578d928e2f2c6"}) SET n += {name: "手工水饺-步骤6", description: "葱、姜切成末，放入肉碗中搅拌均匀。韭菜洗净，切短至3mm以下长度。", stepNumber: "6", methods: "切", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "c5d460060f505830"}) SET n += {name: "手工水饺-步骤7", description: "韭菜和肉沫混合，加入蚝油、生抽、香油各2ml，加入一个鸡蛋的蛋清，用手混合搅拌均匀。放置30分钟即可开始包饺子。", stepNumber: "7", methods: "搅拌", timeEstimate: "30分钟"};
MERGE (n:CookingStep {nodeId: "63be315acc53b866"}) SET n += {name: "手工水饺-步骤8", description: "左手上放面皮，放饺子馅一面尽量不要粘到面粉。右手用筷子夹约面皮1/2直径的馅，沿饺子皮圆周进行合拢，捏实，个人吃无需捏花，饺子皮不漏即可。", stepNumber: "8", methods: "包", tools: "筷子"};
MERGE (n:CookingStep {nodeId: "fa9142d9cedb6db4"}) SET n += {name: "手工水饺-步骤9", description: "使用可放下20只饺子的锅，或分批量煮。烧水，水约3/4锅的高度。大火烧开水后放入饺子，调至中火。", stepNumber: "9", methods: "煮", tools: "锅"};
MERGE (n:CookingStep {nodeId: "ebb1cc9f92a9faa8"}) SET n += {name: "手工水饺-步骤10", description: "第一次放入饺子，且水冒泡后，锅边加入50ml冷水（重复此步骤两次）。第三次水开后加入冷水50ml，水开后调至小火等60s即可出锅。", stepNumber: "10", methods: "煮", tools: "锅"};
MERGE (n:CookingStep {nodeId: "4ea9a5d1d1e94cf0"}) SET n += {name: "日式咖喱饭-步骤1", description: "胡萝卜去头尾，去皮，滚刀切。洋葱剥去外层去芯，切成月牙状。土豆去皮、切大块。肉切块状。剥蒜拍平切碎。咖喱块切碎，增加接触面积加速溶解。", stepNumber: "1", methods: "切", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "b06d5ec852bf94d6"}) SET n += {name: "日式咖喱饭-步骤2", description: "热油锅放入蒜和肉，快速翻炒至肉表面变白。", stepNumber: "2", methods: "炒", tools: "油锅"};
MERGE (n:CookingStep {nodeId: "7df805f576419c3e"}) SET n += {name: "日式咖喱饭-步骤3", description: "加入胡萝卜，快速翻炒至均匀受热。", stepNumber: "3", methods: "炒", tools: "油锅"};
MERGE (n:CookingStep {nodeId: "2b14bda385672248"}) SET n += {name: "日式咖喱饭-步骤4", description: "加入洋葱，快速翻炒至洋葱变透明状。", stepNumber: "4", methods: "炒", tools: "油锅"};
MERGE (n:CookingStep {nodeId: "3a8c6c95c477202c"}) SET n += {name: "日式咖喱饭-步骤5", description: "加入土豆，保持翻炒至土豆变软（可以用筷子确认）。", stepNumber: "5", methods: "炒", tools: "油锅"};
MERGE (n:CookingStep {nodeId: "c6900df944470f28"}) SET n += {name: "日式咖喱饭-步骤6", description: "加水没过所有食材，沸腾后等待15分钟。", stepNumber: "6", methods: "煮", tools: "锅", timeEstimate: "15分钟"};
MERGE (n:CookingStep {nodeId: "d5a3916ec7935a22"}) SET n += {name: "日式咖喱饭-步骤7", description: "关火，加咖喱并搅拌。等待咖喱融化后再开火，缓慢搅拌10分钟，防止糊锅。在外观呈粘稠状态关火结束制作。", stepNumber: "7", methods: "搅拌，煮", tools: "锅", timeEstimate: "10分钟"};
MERGE (n:CookingStep {nodeId: "f9bc721636737d36"}) SET n += {name: "汤面-步骤1", description: "先将菜类材料切成边长不超过4cm的块状，便于煮熟。", stepNumber: "1", methods: "切", tools: "菜刀"};
MERGE (n:CookingStep {nodeId: "9c21c9b75405944d"}) SET n += {name: "汤面-步骤2", description: "如有生肉，则先放入冷水中，盖上锅盖，煮沸腾，先捞出上层血沫，再关火，捞出半熟的肉备用。", stepNumber: "2", methods: "焯水", tools: "锅"};
MERGE (n:CookingStep {nodeId: "4071aa5547b6d405"}) SET n += {name: "汤面-步骤3", description: "先大火将水加热至沸腾，后调至中火。", stepNumber: "3", methods: "煮", tools: "锅"};
MERGE (n:CookingStep {nodeId: "30a475014ef49511"}) SET n += {name: "汤面-步骤4", description: "将较难煮熟的食材放入锅中（比如半熟肉类、香菇类等最先放入锅中）。为保证煮熟，可在沸腾后计时10分钟，特别难熟的大块食材可追加5分钟。", stepNumber: "4", methods: "煮", tools: "锅", timeEstimate: "10-15分钟"};
MERGE (n:CookingStep {nodeId: "5d522694745df271"}) SET n += {name: "汤面-步骤5", description: "将面食放入锅中，适当搅拌确保面和汤充分接触，使液面保持轻微沸腾，煮5分钟。加入面后液面易产生白色泡沫，可适当抬起锅盖通气或者撤下锅盖。", stepNumber: "5", methods: "煮", tools: "锅", timeEstimate: "5分钟"};
MERGE (n:CookingStep {nodeId: "969ffb588ca53db5"}) SET n += {name: "汤面-步骤6", description: "将易于煮熟的食材如青菜类放入锅中，适当搅拌以充分浸没，煮2-5分钟。", stepNumber: "6", methods: "煮", tools: "锅", timeEstimate: "2-5分钟"};
MERGE (n:CookingStep {nodeId: "d1453222f90bec36"}) SET n += {name: "汤面-步骤7", description: "关火，随后加入盐、胡椒粉、香油等自己喜欢的调味料，适当搅拌即可出锅食用。", stepNumber: "7", methods: "调味"};
MERGE (n:CookingStep {nodeId: "36536973f1f8adfb"}) SET n += {name: "炒河粉-步骤1", description: "小葱切碎（葱白和葱叶分开）、蒜瓣拍碎，丢案板上备用。打碎鸡蛋，捞一点蛋清到一只碗中，剩下的丢入另一只碗中备用。", stepNumber: "1", methods: "切，拍", tools: "案板，碗"};
MERGE (n:CookingStep {nodeId: "afd67edd6f2bc2b6"}) SET n += {name: "炒河粉-步骤2", description: "将绿豆芽放入锅中，大火煮60秒。豆芽捞出，过凉水，放入盘中备用。黄瓜切丝放入盘中备用，可和豆芽丢一起。处理面筋，单独丢一个盘中。", stepNumber: "2", methods: "焯水，切", tools: "锅，盘子", timeEstimate: "60秒"};
MERGE (n:CookingStep {nodeId: "ac7841e363c8f343"}) SET n += {name: "炒河粉-步骤3", description: "肉切细条状，加入淀粉与刚刚碗中的鸡蛋清、胡椒粉，顺时针拌匀。", stepNumber: "3", methods: "切，腌制", tools: "碗"};
MERGE (n:CookingStep {nodeId: "e1cafe712d426b2b"}) SET n += {name: "炒河粉-步骤4", description: "加入食用油，锅热倒出。倒入处理好的肉，翻炒均匀至变色，倒入碗中备用。", stepNumber: "4", methods: "炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "1b8de41c02afe646"}) SET n += {name: "炒河粉-步骤5", description: "趁锅热，加入20g食用油，倒入葱白、蒜爆炒出香。加入河粉，淋入老抽提色，翻炒均匀后再加入河粉炒料，继续翻炒。", stepNumber: "5", methods: "炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "a16fe731c724f28e"}) SET n += {name: "炒河粉-步骤6", description: "河粉即将透明时，放入炒制好的肉丝与面筋，并加入生抽提鲜，简单翻炒两次。加入豆芽与黄瓜丝，翻炒至河粉完全透明。关火！", stepNumber: "6", methods: "炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "9bb2e36bb55926db"}) SET n += {name: "炒河粉-步骤7", description: "撒入葱叶点缀，把锅端起。倒入盘中，开始干饭。", stepNumber: "7", tools: "盘子"};
MERGE (n:CookingStep {nodeId: "a0ad162829684ad0"}) SET n += {name: "老友猪肉粉-步骤1", description: "全部猪肉用料酒、盐、生抽、生粉、胡椒粉倒在一个碗里调味，备用。", stepNumber: "1", methods: "调味", tools: "碗"};
MERGE (n:CookingStep {nodeId: "347adf0a9fb1c9d0"}) SET n += {name: "老友猪肉粉-步骤2", description: "热锅不放油，下全部酸笋把水份炒干，炒干的酸笋中间留点空间。", stepNumber: "2", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "32a66538e8e8e297"}) SET n += {name: "老友猪肉粉-步骤3", description: "放入10ml-15ml食用油与全部大蒜、剁椒、豆豉到炒干的酸笋中间，全部推到中间炒出香味。", stepNumber: "3", methods: "炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "634664c1c1746fba"}) SET n += {name: "老友猪肉粉-步骤4", description: "放入全部调味好的猪肉，持续放入10ml生抽炒一分钟。", stepNumber: "4", methods: "炒", tools: "锅", timeEstimate: "1分钟"};
MERGE (n:CookingStep {nodeId: "e5065c3827dd40d4"}) SET n += {name: "老友猪肉粉-步骤5", description: "放入5ml米醋、10ml生抽、450ml清水一起煮开。", stepNumber: "5", methods: "煮", tools: "锅"};
MERGE (n:CookingStep {nodeId: "60c258c77fe1c220"}) SET n += {name: "老友猪肉粉-步骤6", description: "水煮开后，放入温水泡好的米粉，继续煮3分钟就可以盛盘。", stepNumber: "6", methods: "煮", tools: "锅", timeEstimate: "3分钟"};
MERGE (n:CookingStep {nodeId: "797a0db16b8e9987"}) SET n += {name: "葱油拌面-步骤1", description: "将小葱洗净，切成长段（约5-7 cm）。葱白和葱绿可以分开。", stepNumber: "1"};
MERGE (n:CookingStep {nodeId: "cfeafd696644d573"}) SET n += {name: "葱油拌面-步骤2", description: "锅中加入100 ml食用油，中火烧热。先放入葱白段，煸炒至微黄。", stepNumber: "2", methods: "煸炒", tools: "锅"};
MERGE (n:CookingStep {nodeId: "7930a4b7c97bbabb"}) SET n += {name: "葱油拌面-步骤3", description: "加入葱绿段，转小火，继续煸炒。保持小火，耐心煸炒约15-20分钟，直至葱段变得焦黄酥脆。", stepNumber: "3", methods: "煸炒", tools: "锅", timeEstimate: "15-20分钟"};
MERGE (n:CookingStep {nodeId: "c8944b8bd24aba8b"}) SET n += {name: "葱油拌面-步骤4", description: "将焦黄的葱段捞出（葱油保留在锅中）。在锅中的葱油中，加入60 ml生抽，20 ml老抽，15 g白糖。小火加热并搅拌，约1分钟，至糖溶解，酱汁混合均匀。立即关火。将制作好的葱油酱汁倒入容器中，放凉后密封保存。", stepNumber: "4", methods: "加热，搅拌", tools: "锅", timeEstimate: "1分钟"};
MERGE (n:CookingStep {nodeId: "e01686a1dc00a323"}) SET n += {name: "葱油拌面-步骤5", description: "取80 g干面条。锅中加入1000 ml饮用水，大火烧开。放入面条，根据面条包装说明，煮至熟透（通常3-8分钟，以包装说明为准）。", stepNumber: "5", methods: "煮", tools: "锅", timeEstimate: "3-8分钟"};
MERGE (n:CookingStep {nodeId: "d353adcddc31f491"}) SET n += {name: "葱油拌面-步骤6", description: "将煮好的面条捞出，沥干水分，放入碗中。在装有面条的碗中，加入15 ml之前做好的葱油酱汁。可以加入之前炸好的葱段（可选）。用筷子快速搅拌均匀，即可食用。", stepNumber: "6", methods: "搅拌", tools: "碗，筷子"};
MERGE (n:CookingStep {nodeId: "489a2e7ba2ef631b"}) SET n += {name: "蛋炒饭-步骤1", description: "米饭提前用铲子铲成小块。火腿肠、胡萝卜、黄瓜等根据需求切片或者块状。如果家里有熟肉准备好味道更佳。将蛋白，蛋黄分开，分别打入一个大碗里，各自搅匀。注意，不要在这一步加盐。", stepNumber: "1", methods: "准备", tools: "铲子,刀,碗"};
MERGE (n:CookingStep {nodeId: "9b3a4eb48ddacf10"}) SET n += {name: "蛋炒饭-步骤2", description: "大火热锅，待锅里冒烟放入食用油，放入蛋白，待主体凝固后盛出备用。", stepNumber: "2", methods: "炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "795b63b05781e84e"}) SET n += {name: "蛋炒饭-步骤3", description: "如果油够，则直接放入蛋黄，如果油不够则放入食用油并等其升温到大火热锅，待主体凝固后，将火调至中小火。", stepNumber: "3", methods: "炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "fa823c7518cef1a1"}) SET n += {name: "蛋炒饭-步骤4", description: "倒入火腿肠、熟肉，胡萝卜、黄瓜等备料、翻炒10秒钟（到爆香）。重新倒入蛋白，翻炒5s钟，迅速倒入米饭大火翻炒，为的就是每一粒饭都裹上鸡蛋。", stepNumber: "4", methods: "炒", tools: "炒锅", timeEstimate: "15秒"};
MERGE (n:CookingStep {nodeId: "ac3495b9676e9966"}) SET n += {name: "蛋炒饭-步骤5", description: "翻炒过程中将米饭的块状捣碎、这一步过程会比较长、待米饭全部捣碎再翻炒均匀即可。", stepNumber: "5", methods: "炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "6903c839e6eb2378"}) SET n += {name: "蛋炒饭-步骤6", description: "调至小火、加盐、胡椒粉、生抽，进一步翻炒均匀，能看到一些米饭在锅里有“跳起来”的时候其实就已经差不多了。", stepNumber: "6", methods: "炒", tools: "炒锅"};
MERGE (n:CookingStep {nodeId: "bf79ce68433adf66"}) SET n += {name: "蛋炒饭-步骤7", description: "最后倒入香葱再翻炒10s，关火、盛入碗中。", stepNumber: "7", methods: "炒", tools: "炒锅,碗", timeEstimate: "10秒"};

// Recipe 节点
MERGE (n:Recipe {nodeId: "d832a041e14944ef"}) SET n += {name: "手抓饼", category: "早餐", difficulty: "简单", cuisineType: "家常菜", servings: "1-2人份", tips: "使用开水与冷水混合和面，有助于提升饼皮柔韧度。 | 面团醒发时间不宜少于20分钟，否则不易擀薄。 | 可根据个人口味增减配料，建议配料总重控制在100克以内。 | 剩余生饼皮可冷藏保存24小时，使用时回温擀平即可。", filePath: "Dish/breakfast/手抓饼.md"};
MERGE (n:Recipe {nodeId: "2612c911d1e5dab2"}) SET n += {name: "桂圆红枣粥", category: "早餐", difficulty: "简单", cuisineType: "家常菜", cookTime: "70分钟", tips: "对粥的稀稠程度有不同喜好的朋友可以酌情增加或减少水的用量 | 煮出来的粥是甜的，可以通过控制加入桂圆的数量控制甜度", filePath: "Dish/breakfast/桂圆红枣粥.md"};
MERGE (n:Recipe {nodeId: "8265fcbfc7a93654"}) SET n += {name: "水煮玉米", category: "早餐", difficulty: "简单", cuisineType: "家常菜", cookTime: "15-20分钟", tips: "煮玉米时保留部分玉米皮入锅，可增加风味。 | 根据口味选择是否加糖。 | 玉米煮久点不影响口感。", filePath: "Dish/breakfast/水煮玉米.md"};
